# SPDX-License-Identifier: AGPL-3.0-or-later
# Watches for the trigger the device writes when the owner switches the
# bridge on in Settings (issue #145), and starts otc-bridge.service (as
# root) when it appears.
[Unit]
Description=Off The Cloud bridge switch-on trigger

[Path]
PathExists=/var/lib/otc/bridge.request
Unit=otc-bridge.service

[Install]
WantedBy=multi-user.target
