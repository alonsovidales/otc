# Powers the device off as root. Started by otc-poweroff.path when the
# device (running unprivileged, see otc.service's NoNewPrivileges) drops
# /var/lib/otc/poweroff.request - see otc-poweroff-runner.sh.
[Unit]
Description=Off The Cloud shutdown from Settings

[Service]
Type=oneshot
User=root
TimeoutStartSec=1min
ExecStart=/usr/local/bin/otc-poweroff-runner
