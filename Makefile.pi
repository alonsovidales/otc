# ============================================================================
# Makefile.pi — set up an OTC device on a plain Raspberry Pi OS (64-bit)
# install from another computer, over SSH.
#
# Usage:
#   make -f Makefile.pi bootstrap TARGET=<addr> PI_USER=<login> SUBDOMAIN=<name> [DISK1=/dev/sda DISK2=/dev/sdb]
#   make -f Makefile.pi status TARGET=<addr> PI_USER=<login>
#   make -f Makefile.pi help
#
# `bootstrap` runs the one-line installer on the device (the README's
# Option 0): scripts/verified-install.sh installs the newest *signed*
# release - its signature, source archive and web app checked against the
# release key - and everything that comes with it: RAID1 storage, MariaDB,
# the pinned toolchain and models, the config (readable by root and the
# service only), the root helpers that let Settings update the device, its
# release key and version, and the system's own security updates. Before
# that it shows the two disks and asks before it lets the installer wipe
# them (an existing OTC mirror on them is always kept). Re-running it is
# safe: the installer is idempotent and keeps the device's identity.
#
# It used to do the bring-up itself, step by step - and a device made that
# way never updated (no update runner, release key or version file, so
# Update did nothing and every release showed as pending), got no security
# updates, kept its database password in a config every account could read,
# and ran downloads checked by nobody. Those steps are gone; the installer
# is the one way a device is set up.
#
# Assumptions:
#   - The Pi was imaged with Raspberry Pi OS (64-bit), SSH enabled with your
#     key, and a login account with sudo - any name but "otc": the installer
#     creates otc as the device's own service account (no login, no sudo),
#     and would take an existing otc login over as that account.
#   - This machine can reach the Pi over SSH as that account.
# ============================================================================

SHELL          := /bin/bash
.SHELLFLAGS    := -e -o pipefail -c
.ONESHELL:
.DEFAULT_GOAL  := help

# Every recipe below is one shell script (.ONESHELL, GNU make 3.82 and
# newer): an older make runs each line on its own and fails with a syntax
# error. macOS ships 3.81 - `brew install make` adds a current one as gmake.
ifeq ($(filter oneshell,$(.FEATURES)),)
$(error Makefile.pi needs GNU make 3.82 or newer (this is $(MAKE_VERSION)). On macOS: brew install make, then gmake -f Makefile.pi ...)
endif

NO_COLOR       := \033[0m
WARN_COLOR     := \033[33;01m

# ---- Target device ---------------------------------------------------------
PI_USER        ?= pi
TARGET         ?= pit.otc
SSH_OPTS       ?= -o StrictHostKeyChecking=accept-new
SSH            := ssh $(SSH_OPTS) $(PI_USER)@$(TARGET)
# The same with a terminal, for sudo to ask its password on.
SSH_TTY        := ssh $(SSH_OPTS) -t $(PI_USER)@$(TARGET)
SCP            := scp $(SSH_OPTS)

# ---- What the installer is told ---------------------------------------------
# The device's name on the bridge (pit for pit.off-the.cloud): on the
# off-the.cloud bridge it has to belong to an account (README, "Bridge
# accounts"). BRIDGE_ADDR= (empty) installs a device for the home network
# only, which needs no name.
SUBDOMAIN      ?=
BRIDGE_ADDR    ?= off-the.cloud
# The two data disks of the RAID1 mirror; SKIP_RAID=1 for a single-disk
# device (the storage is then a directory on the system disk).
DISK1          ?= /dev/sda
DISK2          ?= /dev/sdb
SKIP_RAID      ?= 0
# The installer, from this project's repository (a fork's own, for a fork).
INSTALLER_URL  ?= https://raw.githubusercontent.com/alonsovidales/otc/main/scripts/verified-install.sh

# ---- For the status targets -----------------------------------------------
HTTP_PORT      ?= 8080
MOUNT_POINT    ?= /mnt/storage

# ---- models-export (the fallback for the tagging model) --------------------
MODEL_DIR          ?= /usr/local/models
MODEL_TAGS         ?= $(MODEL_DIR)/tag_list_4585.txt
MODEL_ENV          ?= otc-model-env
SWAP_MB            ?= 4096

# Pass FORCE=1 to re-run models-export anyway.
FORCE ?=

.PHONY: help
help: ## Show this help
	@echo "Targets:"
	@grep -hE '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | sort | awk 'BEGIN {FS = ":.*?## "}; {printf "  \033[36m%-21s\033[0m %s\n", $$1, $$2}'
	@echo
	@echo "Common variables: TARGET, PI_USER, SUBDOMAIN, DISK1, DISK2, SKIP_RAID, BRIDGE_ADDR"

# =============================================================================
# Setting up the device
# =============================================================================

.PHONY: bootstrap
bootstrap: ping ## Install the newest signed release on TARGET (the one-line installer, over SSH)
	@if [ "$(PI_USER)" = otc ]; then
		echo "Log in with an account other than otc (PI_USER=...): the installer makes otc the device's own service account, with no login and no sudo."
		exit 1
	fi
	if [ -n "$(SUBDOMAIN)" ] && ! [[ "$(SUBDOMAIN)" =~ ^[a-z0-9-]+$$ ]]; then
		echo "SUBDOMAIN is lowercase letters, digits and hyphens only."
		exit 1
	fi
	if [ -n "$(BRIDGE_ADDR)" ] && [ -z "$(SUBDOMAIN)" ]; then
		echo "Set SUBDOMAIN to the device's name on $(BRIDGE_ADDR), or BRIDGE_ADDR= for a device on the home network only."
		exit 1
	fi
	env="OTC_DISK1=$(DISK1) OTC_DISK2=$(DISK2)"
	$(if $(filter command line,$(origin BRIDGE_ADDR)),env="$$env OTC_BRIDGE_ADDR=$(BRIDGE_ADDR)")
	if [ "$(SKIP_RAID)" = "1" ]; then
		echo "SKIP_RAID=1: the storage is a directory on $(TARGET)'s system disk (no RAID)."
		env="$$env OTC_SKIP_RAID=1"
	else
		echo "The data disks on $(TARGET):"
		$(SSH) 'lsblk -o NAME,SIZE,MODEL,FSTYPE,MOUNTPOINTS $(DISK1) $(DISK2) 2>&1 || true' < /dev/null
		# An OTC mirror already on them is assembled and kept, never wiped;
		# two disks without one are erased only once you say so.
		if $(SSH) 'sudo mdadm --examine $(DISK1) $(DISK2) 2>/dev/null | grep -q "Raid Level"' < /dev/null; then
			echo "They hold a RAID array: it is assembled and kept - nothing is wiped."
		else
			echo ""
			echo "No RAID array on $(DISK1) and $(DISK2): the installer will WIPE BOTH and mirror them."
			echo "This DESTROYS ALL DATA on both. Check the list above: are they really the two to erase?"
			read -p "Type 'yes' to continue: " confirm
			[ "$$confirm" = yes ] || { echo "Aborted."; exit 1; }
			env="$$env OTC_RAID_CONFIRM_WIPE=yes"
		fi
	fi
	echo "Running the installer on $(TARGET) (it takes a while: it builds the device's program there)..."
	$(SSH_TTY) "curl -fsSL --retry 3 --connect-timeout 30 '$(INSTALLER_URL)' | sudo $$env bash -s -- '$(SUBDOMAIN)'"
	echo ""
	echo "=========================================================="
	echo " OTC installed on $(TARGET) - it updates itself from Settings from now on."
	echo " Web UI: http://$(TARGET):$(HTTP_PORT)/"
	echo " The device's identity and database password stay on it, in /etc/otc."
	echo "=========================================================="

.PHONY: ping
ping: ## Check SSH connectivity to the device
	@echo "Checking SSH access to $(PI_USER)@$(TARGET)..."
	$(SSH) 'echo "OK: $$(hostname) - $$(uname -srm)"' < /dev/null

# =============================================================================
# First-boot WiFi setup (issue #38)
# =============================================================================

.PHONY: network-setup
network-setup: ## Install the first-boot WiFi/AP watcher service (scripts/network_setup.py)
	@echo "$(WARN_COLOR)CAUTION: this can bring down $(TARGET)'s current network connection"
	@echo "if it decides there's no working one (or you later join a bad network via"
	@echo "the setup wizard) - don't run this against a device you only reach over"
	@echo "the same WiFi it might drop. $(NO_COLOR)"
	@echo "Installing network-setup.service on $(TARGET)..."
	$(SCP) scripts/network_setup.py $(PI_USER)@$(TARGET):/tmp/network_setup.py
	$(SSH) 'sudo mv /tmp/network_setup.py /usr/local/bin/network_setup.py && sudo chmod +x /usr/local/bin/network_setup.py' < /dev/null
	$(SSH) 'sudo tee /etc/systemd/system/network-setup.service >/dev/null' <<-'EOF'
	[Unit]
	Description=OTC first-boot WiFi/AP setup
	After=NetworkManager.service
	Wants=NetworkManager.service

	[Service]
	Type=simple
	ExecStart=/usr/bin/python3 /usr/local/bin/network_setup.py
	Restart=on-failure
	User=root

	[Install]
	WantedBy=multi-user.target
	EOF
	$(SSH) 'sudo systemctl daemon-reload && sudo systemctl enable --now network-setup.service' < /dev/null

.PHONY: network-setup-status
network-setup-status: ## Show network-setup.service status + active connections on the device
	@$(SSH) 'sudo systemctl status network-setup --no-pager; echo; nmcli connection show --active' < /dev/null

# =============================================================================
# Fallback: export the original fp32 RAM++ ONNX model from scratch, directly
# on the device. Only needed if the INT8 model the installer downloads ever
# goes away — this installs a full torch/transformers/timm pipeline in a venv
# on the Pi and runs models/download.py + models/download_tags.py there.
# Expect this to download several GB and take a long time on Pi hardware;
# the `swap` target is a prerequisite to reduce the chance of it getting
# OOM-killed. Writes to its own fp32 filenames in MODEL_DIR (root's, read by
# the service) — update your /etc/otc_*.ini [tagger] section by hand to
# point at them (and drop thresholds-path, since this export has no per-tag
# threshold file).
# =============================================================================

# Issue #156: a swap file on the SD card can keep decrypted data the service
# had in memory (the installer removes it). Only for the one-off
# models-export; run `sudo dphys-swapfile swapoff && sudo dphys-swapfile
# uninstall` afterwards.
.PHONY: swap
swap: ## Bump swap to $(SWAP_MB)MB on disk (only for models-export - see issue #156)
	@echo "Setting swap to $(SWAP_MB)MB on $(TARGET)..."
	$(SSH) '
		if [ -f /etc/dphys-swapfile ]; then
			sudo sed -i "s/^CONF_SWAPSIZE=.*/CONF_SWAPSIZE=$(SWAP_MB)/" /etc/dphys-swapfile
			grep -q "^CONF_SWAPSIZE=" /etc/dphys-swapfile || echo "CONF_SWAPSIZE=$(SWAP_MB)" | sudo tee -a /etc/dphys-swapfile >/dev/null
			sudo systemctl restart dphys-swapfile
		else
			echo "dphys-swapfile not present, skipping (unexpected on Raspberry Pi OS)"
		fi
	' < /dev/null

.PHONY: models-export
models-export: swap ## Fallback: export the fp32 RAM++ ONNX model + tag list from scratch on the device
	@if [ "$(FORCE)" != "1" ] && $(SSH) 'test -f $(MODEL_DIR)/ram_plus_swin_large_14m.onnx && test -f $(MODEL_DIR)/ram_plus_swin_large_14m.onnx.data && test -f $(MODEL_TAGS)' < /dev/null; then
		echo "fp32 model already present at $(MODEL_DIR) on $(TARGET), skipping (pass FORCE=1 to re-export)."
	else
		echo "Setting up the model export environment on $(TARGET) - this is slow, budget significant time and bandwidth."
		# libssl-dev/pkg-config: the tokenizers Rust extension below is built
		# from source and links openssl. gfortran/libopenblas-dev/liblapack-dev:
		# so is scipy, with no prebuilt wheel for this old pin on this
		# Python/arch.
		$(SSH) 'sudo DEBIAN_FRONTEND=noninteractive apt-get install -y python3-venv python3-pip libssl-dev pkg-config gfortran libopenblas-dev liblapack-dev' < /dev/null
		$(SSH) 'test -d ~/$(MODEL_ENV) || python3 -m venv ~/$(MODEL_ENV)' < /dev/null
		# transformers==4.25.1 (pinned below for RAM++ compatibility) pulls in
		# a tokenizers version with no prebuilt wheel for this Python/arch, so
		# pip builds it from source via cargo - which needs a Rust compiler
		# newer than the one Debian packages (rustc/cargo from apt is too old
		# for tokenizers' current transitive deps). Install one via rustup
		# instead of apt.
		$(SSH) '
			set -e
			test -x $$HOME/.cargo/bin/cargo || curl --proto "=https" --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal
		' < /dev/null
		# invalid_reference_casting is a lint that's deny-by-default on
		# current rustc; tokenizers' old pinned source trips it (it predates
		# the lint), so allow it just for this from-source build.
		$(SSH) '
			set -e
			source $$HOME/.cargo/env
			source ~/$(MODEL_ENV)/bin/activate
			export RUSTFLAGS="-A invalid_reference_casting"
			pip install --upgrade pip wheel setuptools
			pip install huggingface_hub
			pip install torch --index-url https://download.pytorch.org/whl/cpu || pip install torch
			# Current torch routes torch.onnx.export through its newer
			# exporter, which needs onnxscript even for the legacy path.
			pip install onnxscript
			pip install timm==0.4.12 transformers==4.25.1 fairscale==0.4.4
			pip install "git+https://github.com/xinyu1205/recognize-anything.git"
			# Unpinned: download.py does not call scipy directly (this is
			# only here in case a transitive dep needs it), and pinning it
			# to the old <1.13 range forces a from-source build with no
			# prebuilt wheel for this Python/arch. Let pip pick a recent
			# scipy that ships one instead.
			pip install scipy yacs einops
		' < /dev/null
		$(SCP) models/download.py models/download_tags.py $(PI_USER)@$(TARGET):~/$(MODEL_ENV)/
		echo "Exporting the ONNX model (this is the slow part)..."
		$(SSH) 'cd ~/$(MODEL_ENV) && source bin/activate && python download.py ram_plus --imgsz 384 --classes 4585' < /dev/null
		echo "Downloading the tag list..."
		$(SSH) 'cd ~/$(MODEL_ENV) && source bin/activate && python download_tags.py' < /dev/null
		# This model is >2GB, so torch.onnx.export writes its weights to a
		# companion *.onnx.data file alongside the small .onnx graph file
		# (ONNX's external-data format) - onnxruntime needs both at the
		# same relative path to load it, so ship both. Into the models
		# directory as root's files, read-only to the service, as the
		# installer keeps it.
		$(SSH) '
			set -e
			sudo install -d -o root -g root -m 0755 $(MODEL_DIR)
			sudo install -o root -g root -m 0644 ~/$(MODEL_ENV)/ram_plus/onnx/ram_plus_swin_large_14m.onnx $(MODEL_DIR)/ram_plus_swin_large_14m.onnx
			sudo install -o root -g root -m 0644 ~/$(MODEL_ENV)/ram_plus/onnx/ram_plus_swin_large_14m.onnx.data $(MODEL_DIR)/ram_plus_swin_large_14m.onnx.data
			sudo install -o root -g root -m 0644 ~/$(MODEL_ENV)/models/ram_plus/tags/tag_list_4585.txt $(MODEL_TAGS)
		' < /dev/null
		echo "fp32 model installed at $(MODEL_DIR) on $(TARGET)."
	fi

# =============================================================================
# Day to day operations
# =============================================================================

.PHONY: status
status: ## Show service/DB/RAID/health status on the device
	@$(SSH) '
		echo "-- otc.service --"; sudo systemctl --no-pager --lines=0 status otc.service || true
		echo; echo "-- mariadb --"; sudo systemctl --no-pager --lines=0 status mariadb || true
		echo; echo "-- RAID --"; cat /proc/mdstat 2>/dev/null || true
		echo; echo "-- storage --"; df -h $(MOUNT_POINT) 2>/dev/null || true
		echo; echo "-- release --"; cat /etc/otc/version 2>/dev/null || echo "no /etc/otc/version"
		echo; curl -sf http://localhost:$(HTTP_PORT)/check_healty >/dev/null && echo "healthcheck: OK" || echo "healthcheck: FAILED"
	' < /dev/null

.PHONY: raid-status
raid-status: ## Show RAID/disk status on the device
	@$(SSH) 'cat /proc/mdstat; echo; df -h $(MOUNT_POINT) 2>&1 || true' < /dev/null

.PHONY: logs
logs: ## Tail the otc service logs on the device
	@$(SSH) 'sudo journalctl -u otc -n 200 -f'

.PHONY: restart
restart: ## Restart the otc service on the device
	@$(SSH) 'sudo systemctl restart otc.service' < /dev/null
