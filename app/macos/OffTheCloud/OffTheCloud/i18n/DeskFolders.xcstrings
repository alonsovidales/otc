    "desk.folders.flash_next_steps" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte ist bereit. Stecke sie in den Raspberry Pi 5, schließe die beiden USB-Laufwerke an und schalte ihn ein.\n\nTippe dann in der App Off The Cloud auf deinem Handy (iOS oder Android) auf „Neues Gerät einrichten“: Sie findet den Pi über Bluetooth und führt dich durch den Rest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card is ready. Put it in the Raspberry Pi 5, plug in the two USB disks and power it on.\n\nThen, in the Off The Cloud app on your phone (iOS or Android), tap \"Set up a new device\": it finds the Pi over Bluetooth and walks you through the rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tarjeta está lista. Ponla en la Raspberry Pi 5, conecta los dos discos USB y enciéndela.\n\nDespués, en la app Off The Cloud de tu teléfono (iOS o Android), toca “Configurar dispositivo nuevo”: encontrará la Pi por Bluetooth y te guiará en el resto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte est prête. Insérez-la dans le Raspberry Pi 5, branchez les deux disques USB et allumez-le.\n\nEnsuite, dans l’app Off The Cloud sur votre téléphone (iOS ou Android), touchez « Configurer un nouvel appareil » : elle trouve le Pi par Bluetooth et vous guide pour la suite."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda è pronta. Inseriscila nel Raspberry Pi 5, collega i due dischi USB e accendilo.\n\nPoi, nell’app Off The Cloud sul telefono (iOS o Android), tocca “Configura un nuovo dispositivo”: troverà il Pi tramite Bluetooth e ti guiderà nel resto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart is klaar. Plaats hem in de Raspberry Pi 5, sluit de twee USB-schijven aan en zet hem aan.\n\nTik daarna in de Off The Cloud-app op je telefoon (iOS of Android) op “Nieuw apparaat instellen”: de app vindt de Pi via Bluetooth en helpt je met de rest."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão está pronto. Coloca-o no Raspberry Pi 5, encaixa os dois discos USB e liga-o.\n\nDepois, na app Off The Cloud do teu telemóvel (iOS ou Android), toca em «Configurar um novo dispositivo»: a app encontra o Pi por Bluetooth e guia-te no resto."
          }
        }
      }
    },
