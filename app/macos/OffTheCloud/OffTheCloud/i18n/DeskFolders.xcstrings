    "desk.folders.picker_prompt" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordner auf dem Gerät: %1$@ – doppelklicke auf einen Ordner, um ihn zu öffnen, oder wähle „%2$@“ aus, um ihn mit einem Ordner auf diesem Computer synchron zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
