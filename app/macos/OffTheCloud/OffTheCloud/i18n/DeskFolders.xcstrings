    "desk.folders.flash_disk_changed" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "das Laufwerk %1$@ hat sich nach der Auswahl geändert (jetzt %2$@) – es wurde nichts geschrieben; wähle die Karte erneut"
