    "desk.folders.setup_windows_format" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Windows anbietet, die Karte zu formatieren, wähle „Abbrechen“: Windows kann die Linux-Partition des Geräts nicht lesen, und das ist normal."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If Windows offers to format the card, choose Cancel: Windows can't read the device's Linux partition, and that is expected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Windows te ofrece formatear la tarjeta, elige Cancelar: Windows no puede leer la partición Linux del dispositivo, y es lo esperado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si Windows propose de formater la carte, choisissez Annuler : Windows ne peut pas lire la partition Linux de l’appareil, et c’est normal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se Windows propone di formattare la scheda, scegli Annulla: Windows non può leggere la partizione Linux del dispositivo, ed è normale."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Windows aanbiedt de kaart te formatteren, kies dan Annuleren: Windows kan de Linux-partitie van het apparaat niet lezen, en dat is normaal."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se o Windows se oferecer para formatar o cartão, escolhe Cancelar: o Windows não consegue ler a partição Linux do dispositivo, e isso é normal."
          }
        }
      }
    },
