          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carpeta remota: %1$@. Haz doble clic en una carpeta para abrirla, o elige “%2$@” para mantenerla sincronizada con una carpeta de este ordenador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dossier distant : %1$@ – double-cliquez sur un dossier pour l’ouvrir, ou choisissez « %2$@ » pour le garder synchronisé avec un dossier de cet ordinateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cartella remota: %1$@ — fai doppio clic su una cartella per aprirla, oppure scegli “%2$@” per mantenerla sincronizzata con una cartella di questo computer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Externe map: %1$@ – dubbelklik op een map om die te openen, of kies “%2$@” om die gesynchroniseerd te houden met een map op deze computer."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pasta remota: %1$@ — faz duplo clique numa pasta para a abrir ou escolhe «%2$@» para a manter sincronizada com uma pasta deste computador."
          }
        }
      }
    },
