    "desk.folders.flash_card_in_use" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "die Karte wird verwendet (%1$@): Schließe alle Fenster oder Programme, die sie nutzen, und versuche es erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "the card is in use (%1$@): close any window or program using it and try again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la tarjeta está en uso (%1$@): cierra cualquier ventana o programa que la esté usando y vuelve a intentarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la carte est utilisée (%1$@) : fermez toute fenêtre ou tout programme qui l’utilise et réessayez"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "la scheda è in uso (%1$@): chiudi le finestre o i programmi che la usano e riprova"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "de kaart is in gebruik (%1$@): sluit alle vensters en programma’s die de kaart gebruiken en probeer het opnieuw"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "o cartão está a ser usado (%1$@): fecha as janelas ou os programas que o estejam a usar e tenta novamente"
          }
        }
      }
    },
