    "desk.folders.setup_erase_question" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles auf diesem Laufwerk wird gelöscht:\n\n%1$@\n\nDas Image von Off The Cloud darauf schreiben?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything on this disk will be erased:\n\n%1$@\n\nWrite the Off The Cloud image to it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrará todo lo que hay en este disco:\n\n%1$@\n\n¿Escribir en él la imagen de Off The Cloud?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le contenu de ce disque sera effacé :\n\n%1$@\n\nY écrire l’image Off The Cloud ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto il contenuto di questo disco verrà cancellato:\n\n%1$@\n\nScrivere l’immagine di Off The Cloud sul disco?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles op deze schijf wordt gewist:\n\n%1$@\n\nDe Off The Cloud-image ernaar schrijven?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que está neste disco vai ser apagado:\n\n%1$@\n\nEscrever a imagem Off The Cloud neste disco?"
          }
        }
      }
    },
    "desk.folders.setup_insert_card" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stecke die SD-Karte ein (in den Kartensteckplatz des Computers oder einen USB-Kartenleser) und versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insert the SD card (in the computer's card slot or a USB card reader), then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserta la tarjeta SD (en la ranura de tarjetas del ordenador o en un lector de tarjetas USB) y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez la carte SD (dans le lecteur de cartes de l’ordinateur ou un lecteur de cartes USB), puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la scheda SD (nello slot per schede del computer o in un lettore di schede USB), poi riprova."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats de SD-kaart (in de kaartsleuf van de computer of in een USB-kaartlezer) en probeer het opnieuw."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insere o cartão SD (na ranhura de cartões do computador ou num leitor de cartões USB) e tenta novamente."
          }
        }
      }
    },
    "desk.folders.setup_intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit wird die SD-Karte für ein neues Gerät von Off The Cloud vorbereitet:\n\n1. Das Image des Geräts herunterladen (etwa 560 MB).\n2. Es auf eine SD-Karte mit mindestens 8 GB schreiben – alles auf der Karte wird gelöscht.\n3. Den Download löschen.\n\nDu brauchst einen Raspberry Pi 5 mit 8 GB RAM, die SD-Karte und zwei USB-Laufwerke."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This prepares the SD card for a new Off The Cloud device:\n\n1. Download the device image (about 560 MB).\n2. Write it to an SD card of 8 GB or more - everything on the card is erased.\n3. Delete the download.\n\nYou need a Raspberry Pi 5 with 8 GB of RAM, the SD card and two USB disks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto prepara la tarjeta SD para un nuevo dispositivo Off The Cloud:\n\n1. Descargar la imagen del dispositivo (unos 560 MB).\n2. Escribirla en una tarjeta SD de 8 GB o más: se borra todo lo que hay en la tarjeta.\n3. Eliminar la descarga.\n\nNecesitas una Raspberry Pi 5 con 8 GB de RAM, la tarjeta SD y dos discos USB."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet assistant prépare la carte SD d’un nouvel appareil Off The Cloud :\n\n1. Télécharger l’image de l’appareil (environ 560 Mo).\n2. L’écrire sur une carte SD d’au moins 8 Go : tout le contenu de la carte est effacé.\n3. Supprimer le téléchargement.\n\nIl vous faut un Raspberry Pi 5 avec 8 Go de RAM, la carte SD et deux disques USB."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa procedura prepara la scheda SD per un nuovo dispositivo Off The Cloud:\n\n1. Download dell’immagine del dispositivo (circa 560 MB).\n2. Scrittura su una scheda SD da 8 GB o più: tutto ciò che c’è sulla scheda viene cancellato.\n3. Eliminazione del file scaricato.\n\nTi servono un Raspberry Pi 5 con 8 GB di RAM, la scheda SD e due dischi USB."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hiermee bereid je de SD-kaart voor op een nieuw Off The Cloud-apparaat:\n\n1. Download de image van het apparaat (ongeveer 560 MB).\n2. Schrijf de image naar een SD-kaart van 8 GB of meer – alles op de kaart wordt gewist.\n3. Verwijder de download.\n\nJe hebt een Raspberry Pi 5 met 8 GB RAM nodig, plus de SD-kaart en twee USB-schijven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto prepara o cartão SD para um novo dispositivo Off The Cloud:\n\n1. Transferir a imagem do dispositivo (cerca de 560 MB).\n2. Escrevê-la num cartão SD de 8 GB ou mais: tudo o que estiver no cartão é apagado.\n3. Eliminar a transferência.\n\nPrecisas de um Raspberry Pi 5 com 8 GB de RAM, do cartão SD e de dois discos USB."
          }
        }
      }
    },
    "desk.folders.setup_not_written" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte wurde nicht beschrieben: Zum Beschreiben einer SD-Karte sind Administratorrechte nötig. Wähle %1$@ erneut, wenn du so weit bist (der Download bleibt erhalten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The card was not written: writing an SD card needs administrator permission. Choose %1$@ again when you are ready (the download is kept)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha escrito la tarjeta: escribir en una tarjeta SD requiere permiso de administrador. Vuelve a elegir %1$@ cuando quieras (la descarga se conserva)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La carte n’a pas été écrite : l’écriture d’une carte SD nécessite l’autorisation d’un administrateur. Choisissez de nouveau %1$@ quand vous le souhaitez (le téléchargement est conservé)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La scheda non è stata scritta: per scrivere una scheda SD servono i permessi di amministratore. Scegli di nuovo %1$@ quando vuoi (il download viene conservato)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De kaart is niet beschreven: voor het beschrijven van een SD-kaart zijn beheerdersrechten nodig. Kies opnieuw %1$@ wanneer je klaar bent (de download blijft bewaard)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão não foi escrito: escrever num cartão SD requer permissão de administrador. Escolhe %1$@ novamente quando quiseres (a transferência é mantida)."
          }
        }
      }
    },
