    "desk.main.images_show_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos und Videos darin erscheinen wieder in „Bilder“ und erhalten im Hintergrund Tags – und werden nach Gesichtern durchsucht, falls die Gesichtserkennung aktiviert ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its photos and videos go back to Images, and are tagged - and searched for faces, if face recognition is on - in the background."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus fotos y vídeos vuelven a Imágenes y se etiquetan (y se analizan en busca de caras, si el reconocimiento facial está activado) en segundo plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses photos et vidéos reviennent dans Images et sont étiquetées (et analysées pour y rechercher des visages, si la reconnaissance faciale est activée) en arrière-plan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue foto e i suoi video tornano in Immagini e vengono etichettati (e analizzati alla ricerca di volti, se il riconoscimento facciale è attivo) in background."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s en video’s erin komen terug in Afbeeldingen en krijgen op de achtergrond tags (en worden doorzocht op gezichten, als gezichtsherkenning aanstaat)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e os vídeos dela voltam a Imagens e são etiquetados (e analisados para encontrar rostos, se o reconhecimento facial estiver ativo) em segundo plano."
          }
