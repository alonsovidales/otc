    "desk.main.autostart_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Ordner werden nach einem Neustart deines Computers im Hintergrund weiter synchronisiert. Du kannst das im Menü mit „Bei der Anmeldung öffnen“ ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your folders keep syncing in the background after you restart your computer. You can change this with “Start at login” in the menu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus carpetas siguen sincronizándose en segundo plano después de reiniciar el ordenador. Puedes cambiarlo con “Abrir al iniciar sesión” en el menú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos dossiers continuent de se synchroniser en arrière-plan après le redémarrage de votre ordinateur. Vous pouvez modifier ce choix avec « Ouvrir avec la session » dans le menu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue cartelle continuano a sincronizzarsi in background dopo il riavvio del computer. Puoi cambiare questa scelta con “Apri al login” nel menu."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je mappen blijven op de achtergrond synchroniseren nadat je je computer opnieuw hebt opgestart. Je kunt dit wijzigen met “Openen bij inloggen” in het menu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas pastas continuam a sincronizar em segundo plano depois de reiniciares o computador. Podes alterar isto com «Abrir ao iniciar sessão» no menu."
          }
        }
      }
    },
