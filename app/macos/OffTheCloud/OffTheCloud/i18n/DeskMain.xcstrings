    "desk.main.images_keep_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos und Videos darin erhalten keine Tags, werden nicht nach Gesichtern durchsucht und nicht in „Bilder“ angezeigt, und bereits darin gefundene Tags und Gesichter werden gelöscht. In Dateien sind sie weiterhin sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its photos and videos won't be tagged, searched for faces or shown in Images, and the tags and faces already found in them are deleted. Files still shows them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus fotos y vídeos no se etiquetarán, no se analizarán en busca de caras ni se mostrarán en Imágenes, y se eliminarán las etiquetas y caras ya encontradas en ellos. Archivos los sigue mostrando."
          }
        },
        "fr" : {
          "stringUnit" : {
