    "macos.setup.switch_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac ist mit %1$@ verbunden. Beim Wechseln werden alle deine synchronisierten Ordner aus dieser App entfernt, damit keiner davon versehentlich mit dem neuen Gerät synchronisiert wird. Die Dateien selbst bleiben auf diesem Mac und auf dem alten Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Mac is connected to %1$@. Switching removes all your synced folders from this app, so none of them starts syncing with the new device by mistake. The files themselves stay on this Mac and on the old device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está conectado a %1$@. Al cambiar, se quitan todas tus carpetas sincronizadas de esta app, para que ninguna empiece a sincronizarse con el dispositivo nuevo por error. Los archivos siguen en este Mac y en el dispositivo anterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac est connecté à l’appareil %1$@. Basculer retire tous vos dossiers synchronisés de cette app, pour qu’aucun d’eux ne se mette par erreur à se synchroniser avec le nouvel appareil. Les fichiers eux-mêmes restent sur ce Mac et sur l’ancien appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac è connesso a %1$@. Passando al nuovo dispositivo, tutte le tue cartelle sincronizzate vengono rimosse da questa app, così nessuna inizia per errore a sincronizzarsi con il nuovo dispositivo. I file restano su questo Mac e sul vecchio dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze Mac is verbonden met %1$@. Als je overschakelt, worden al je gesynchroniseerde mappen uit deze app verwijderd, zodat geen enkele map per ongeluk met het nieuwe apparaat gaat synchroniseren. De bestanden zelf blijven op deze Mac en op het oude apparaat staan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac está ligado a %1$@. Mudar remove todas as tuas pastas sincronizadas desta app, para que nenhuma comece a sincronizar com o novo dispositivo por engano. Os próprios ficheiros ficam neste Mac e no dispositivo antigo."
          }
        }
      }
    },
