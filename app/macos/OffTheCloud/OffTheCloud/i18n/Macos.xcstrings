    "macos.setup.write_step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„OS wählen“: Scrolle nach unten zu „Eigenes Image“ und wähle %1$@ in deinem Downloads-Ordner (es ist im Finder ausgewählt) – es sei denn, Imager zeigt es bereits an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose OS: scroll down to Use custom and pick %1$@ in your Downloads folder (it is selected in Finder) - unless Imager already shows it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir SO: desplázate hacia abajo hasta “Usar personalizado” y elige %1$@ en tu carpeta Descargas (está seleccionado en el Finder), a menos que Imager ya lo muestre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir l’OS : faites défiler jusqu’à « Utiliser image personnalisée » et choisissez %1$@ dans votre dossier Téléchargements (il est sélectionné dans le Finder), sauf si Imager l’affiche déjà."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli S.O.: scorri fino a “Usa immagine personalizzata” e scegli %1$@ nella cartella Download (è selezionato nel Finder), a meno che Imager non lo mostri già."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies OS: scrol omlaag naar “Gebruik eigen bestand” en kies %1$@ in je map Downloads (het bestand is geselecteerd in de Finder), tenzij Imager het al toont."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher SO: desce até «Utilizar ficheiro personalizado» e escolhe %1$@ na tua pasta Descargas (está selecionado no Finder), a não ser que o Imager já o mostre."
          }
        }
      }
    },
    "macos.setup.write_step4" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„SD-Karte wählen“: deine SD-Karte. Alles darauf wird gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose Storage: your SD card. Everything on it is erased."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elegir almacenamiento: tu tarjeta SD. Se borra todo lo que contiene."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisir le stockage : votre carte SD. Tout son contenu est effacé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli scheda SD: la tua scheda SD. Tutto il suo contenuto viene cancellato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies opslag: je SD-kaart. Alles op de kaart wordt gewist."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolher armazenamento: o teu cartão SD. Tudo o que estiver nele é apagado."
          }
        }
      }
    },
    "macos.setup.write_step5" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke auf „Weiter“ und antworte mit „Nein“, wenn Imager fragt, ob die OS-Anpassungen angewendet werden sollen: Das Gerät wird von diesem Mac oder deinem Handy aus eingerichtet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Click Next and answer No to \"apply OS customisation settings\": the device is set up from this Mac or your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic en Siguiente y responde No a “aplicar los ajustes de personalización del SO”: el dispositivo se configura desde este Mac o desde tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cliquez sur Suivant et répondez Non à « appliquer les réglages de personnalisation de l’OS » : l’appareil se configure depuis ce Mac ou votre téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic su Avanti e, quando ti chiede se applicare le impostazioni di personalizzazione del sistema operativo, rispondi No: il dispositivo si configura da questo Mac o dal telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik op Volgende en antwoord Nee als Imager vraagt of je je eigen instellingen op het OS wilt toepassen: het apparaat wordt ingesteld vanaf deze Mac of je telefoon."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clica em Seguinte e responde Não a «aplicar definições de personalização do SO»: o dispositivo é configurado a partir deste Mac ou do teu telemóvel."
          }
        }
      }
    },
    "macos.setup.write_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS erlaubt nur Apps außerhalb des App Store, SD-Karten zu beschreiben, deshalb übernimmt Raspberry Pi Imager diesen Schritt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS only lets apps outside the App Store write SD cards, so Raspberry Pi Imager does this step."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS solo permite escribir tarjetas SD a las apps de fuera de App Store, así que Raspberry Pi Imager hace este paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’autorise que les apps distribuées hors de l’App Store à écrire sur des cartes SD : c’est donc Raspberry Pi Imager qui se charge de cette étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS consente di scrivere schede SD solo alle app che non provengono da App Store, quindi questo passaggio lo esegue Raspberry Pi Imager."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS laat alleen apps van buiten de App Store SD-kaarten beschrijven, dus Raspberry Pi Imager doet deze stap."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS só deixa que apps de fora da App Store escrevam cartões SD, por isso o Raspberry Pi Imager faz este passo."
          }
        }
      }
    },
