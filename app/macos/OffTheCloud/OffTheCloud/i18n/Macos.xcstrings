    "macos.setup.intro_step3" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Karte in den Pi stecken, die Laufwerke anschließen, ihn einschalten und die Einrichtung hier über Bluetooth oder auf deinem Handy abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the card in the Pi, connect the disks, power it on and finish the setup here over Bluetooth, or on your phone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la tarjeta en la Pi, conecta los discos, enciéndela y termina la configuración aquí por Bluetooth o en tu teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez la carte dans le Pi, branchez les disques, allumez-le et terminez la configuration ici par Bluetooth, ou sur votre téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la scheda nel Pi, collega i dischi, accendilo e completa la configurazione qui tramite Bluetooth, oppure sul telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats de kaart in de Pi, sluit de schijven aan, zet hem aan en voltooi de configuratie hier via Bluetooth, of op je telefoon."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Colocar o cartão no Pi, encaixar os discos, ligá-lo e concluir a configuração aqui, por Bluetooth, ou no teu telemóvel."
          }
        }
      }
    },
    "macos.setup.intro_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Raspberry Pi 5 (8 GB) mit einer microSD-Karte und zwei USB-Laufwerken wird zu deinem Gerät von Off The Cloud."
          }
        },
        "en" : {
          "stringUnit" : {
