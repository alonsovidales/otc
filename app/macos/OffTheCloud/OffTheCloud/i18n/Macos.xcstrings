    "macos.setup.start_subtitle" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stecke die Karte in den Pi, schließe die beiden USB-Laufwerke an und schalte ihn ein. Das Starten dauert ein, zwei Minuten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Put the card in the Pi, connect the two USB disks, and power it on. It takes a minute or two to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon la tarjeta en la Pi, conecta los dos discos USB y enciéndela. Tarda uno o dos minutos en arrancar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Insérez la carte dans le Pi, branchez les deux disques USB et allumez-le. Le démarrage prend une minute ou deux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci la scheda nel Pi, collega i due dischi USB e accendilo. L’avvio richiede un minuto o due."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plaats de kaart in de Pi, sluit de twee USB-schijven aan en zet hem aan. Het opstarten duurt een minuut of twee."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca o cartão no Pi, encaixa os dois discos USB e liga-o. Demora um ou dois minutos a arrancar."
          }
        }
      }
    },
