      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe in der App Off The Cloud für iPhone oder Android auf „Neues Gerät einrichten“. Die App findet das Gerät über Bluetooth und zeigt seine Einrichtung."
          }
        },
        "en" : {
          "stringUnit" : {
