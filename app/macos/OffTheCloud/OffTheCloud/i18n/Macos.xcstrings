    "macos.settings.disconnect_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle deine synchronisierten Ordner werden aus dieser App entfernt, damit keiner davon versehentlich mit einem anderen Gerät synchronisiert wird. Die Dateien selbst bleiben auf diesem Mac und auf dem Gerät. Du kannst die Ordner nach dem Verbinden wieder hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All your synced folders are removed from this app, so none of them starts syncing with a different device by mistake. The files themselves stay on this Mac and on the device. You can add the folders again after connecting."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas tus carpetas sincronizadas se quitan de esta app, para que ninguna empiece a sincronizarse con otro dispositivo por error. Los archivos siguen en este Mac y en el dispositivo. Puedes volver a añadir las carpetas después de conectarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous vos dossiers synchronisés sont retirés de cette app, pour qu’aucun d’eux ne se mette par erreur à se synchroniser avec un autre appareil. Les fichiers eux-mêmes restent sur ce Mac et sur l’appareil. Vous pourrez ajouter de nouveau les dossiers une fois la connexion établie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutte le tue cartelle sincronizzate vengono rimosse da questa app, così nessuna inizia per errore a sincronizzarsi con un altro dispositivo. I file restano su questo Mac e sul dispositivo. Puoi aggiungere di nuovo le cartelle dopo la connessione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al je gesynchroniseerde mappen worden uit deze app verwijderd, zodat geen enkele map per ongeluk met een ander apparaat gaat synchroniseren. De bestanden zelf blijven op deze Mac en op het apparaat staan. Je kunt de mappen opnieuw toevoegen nadat je verbinding hebt gemaakt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas as tuas pastas sincronizadas são removidas desta app, para que nenhuma comece a sincronizar com outro dispositivo por engano. Os próprios ficheiros ficam neste Mac e no dispositivo. Podes voltar a adicionar as pastas depois de te ligares."
          }
        }
      }
    },
