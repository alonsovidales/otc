    "macos.setup.done_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge über das Symbol von Off The Cloud in der Menüleiste Ordner hinzu, die gesichert oder synchron gehalten werden sollen. Die eigene Seite des Geräts im Browser enthält deine Fotos, Dateien und Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add folders to back up or keep in sync from the Off The Cloud menu bar icon. The device's own page, in a browser, has your photos, files and settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade carpetas para hacer copias de seguridad o mantenerlas sincronizadas desde el icono de Off The Cloud de la barra de menús. La propia página del dispositivo, en un navegador, tiene tus fotos, archivos y ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des dossiers à sauvegarder ou à garder synchronisés depuis l’icône Off The Cloud de la barre des menus. La page de l’appareil, dans un navigateur, contient vos photos, vos fichiers et vos paramètres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi le cartelle di cui fare il backup o da mantenere sincronizzate dall’icona di Off The Cloud nella barra dei menu. La pagina del dispositivo, in un browser, contiene le tue foto, i tuoi file e le impostazioni."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voeg via het Off The Cloud-symbool in de menubalk mappen toe om een reservekopie van te maken of gesynchroniseerd te houden. De eigen pagina van het apparaat, in een browser, bevat je foto’s, bestanden en instellingen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona pastas para fazer cópias de segurança ou manter sincronizadas a partir do ícone do Off The Cloud na barra de menus. A página do próprio dispositivo, num navegador, tem as tuas fotos, os teus ficheiros e as tuas definições."
          }
        }
      }
    },
