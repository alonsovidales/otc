    "macos.bluetooth.looking_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte das Gerät mit angeschlossenen Laufwerken ein. Bis es eingerichtet ist, ist es über Bluetooth sichtbar; halte diesen Mac in seiner Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Power the device on with its disks connected. Until it is set up it announces itself over Bluetooth; keep this Mac near it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enciende el dispositivo con sus discos conectados. Hasta que esté configurado, se anuncia por Bluetooth; mantén este Mac cerca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allumez l’appareil avec ses disques branchés. Tant qu’il n’est pas configuré, il se signale par Bluetooth ; gardez ce Mac près de lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accendi il dispositivo con i dischi collegati. Finché non è configurato si annuncia tramite Bluetooth: tieni questo Mac vicino al dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet het apparaat aan met de schijven aangesloten. Zolang het niet is ingesteld, maakt het zich via Bluetooth bekend; houd deze Mac er vlakbij."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liga o dispositivo com os discos instalados. Até estar configurado, anuncia-se por Bluetooth; mantém este Mac perto dele."
          }
        }
      }
    },
