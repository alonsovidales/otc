    "macos.folders.restored_files" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ Dateien waren vom Gerät verschwunden – sie wurden von diesem Mac aus wiederhergestellt, statt hier gelöscht zu werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ files had disappeared from the device - restored them from this Mac instead of deleting them here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ archivos habían desaparecido del dispositivo: se han restaurado desde este Mac en lugar de eliminarlos aquí"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ fichiers avaient disparu de l’appareil : ils ont été restaurés depuis ce Mac au lieu d’être supprimés ici"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ file erano spariti dal dispositivo: sono stati ripristinati da questo Mac anziché essere eliminati qui"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ bestanden waren van het apparaat verdwenen – ze zijn vanaf deze Mac hersteld in plaats van hier te worden verwijderd"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ficheiros tinham desaparecido do dispositivo: foram restaurados a partir deste Mac em vez de serem eliminados aqui"
          }
        }
      }
    },
    "macos.images.add_info" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das später mit dem Augensymbol in der Zeile des Ordners ändern. Ein später umbenannter Ordner ist auf dem Gerät ein neuer Ordner: Blende ihn dann erneut in „Bilder“ aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can change it later with the eye button on the folder's row. A folder renamed later is a new folder on the device: keep it out of Images again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cambiarlo más adelante con el botón del ojo en la fila de la carpeta. Una carpeta a la que se cambie el nombre más adelante es una carpeta nueva en el dispositivo: vuelve a excluirla de Imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez changer cela plus tard avec le bouton en forme d’œil sur la ligne du dossier. Un dossier renommé par la suite devient un nouveau dossier sur l’appareil : excluez-le de nouveau d’Images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi cambiare questa scelta in seguito con il pulsante a forma di occhio nella riga della cartella. Una cartella rinominata in seguito è una nuova cartella sul dispositivo: escludila di nuovo da Immagini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt dit later wijzigen met de oogknop in de rij van de map. Een map die later een andere naam krijgt, is een nieuwe map op het apparaat: houd die opnieuw buiten Afbeeldingen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podes alterar isto mais tarde com o botão do olho na linha da pasta. Uma pasta a que mudes o nome mais tarde passa a ser uma pasta nova no dispositivo: volta a mantê-la fora de Imagens."
          }
        }
      }
    },
