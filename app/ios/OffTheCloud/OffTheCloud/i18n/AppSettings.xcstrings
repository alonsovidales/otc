    "app.settings.sync_choice.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine ganze Mediathek zu synchronisieren kann lange dauern und viele Daten verbrauchen. Mit „Nur über WLAN“ wird nichts über mobile Daten gesendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syncing a whole library can take a long time and use a lot of data. With Wi-Fi only on, nothing is sent over mobile data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar toda una biblioteca puede llevar mucho tiempo y gastar muchos datos. Con “Solo con Wi-Fi” activado, no se envía nada con datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Synchroniser toute une bibliothèque peut prendre longtemps et consommer beaucoup de données. Avec « Wi-Fi uniquement » activé, rien n’est envoyé par les données mobiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizzare un’intera libreria può richiedere molto tempo e consumare molti dati. Con “Solo Wi-Fi” attivo, non viene inviato nulla con i dati mobili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een hele bibliotheek synchroniseren kan lang duren en veel data verbruiken. Met “Alleen via wifi” aan wordt er niets via mobiele data verstuurd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizar uma biblioteca inteira pode demorar muito tempo e gastar muitos dados. Com «Apenas por Wi-Fi» ativado, nada é enviado pelos dados móveis."
          }
        }
      }
    },
