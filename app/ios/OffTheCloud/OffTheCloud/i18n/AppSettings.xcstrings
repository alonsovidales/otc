    "app.settings.language_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf deinem Gerät gespeichert, sodass jede dort angemeldete App dieselbe Sprache verwendet. „Automatisch“ folgt der Spracheinstellung dieses Handys."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saved on your device, so every app signed in to it uses the same language. Automatic follows the language this phone is set to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se guarda en tu dispositivo, así que todas las apps que han iniciado sesión en él usan el mismo idioma. Automático sigue el idioma configurado en este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce choix est enregistré sur votre appareil : toutes les apps qui y sont connectées utilisent donc la même langue. « Automatique » suit la langue définie sur ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata sul tuo dispositivo, così tutte le app collegate usano la stessa lingua. “Automatica” segue la lingua impostata su questo telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opgeslagen op je apparaat, zodat elke app die erop is ingelogd dezelfde taal gebruikt. Automatisch volgt de taal waarop deze telefoon is ingesteld."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardado no teu dispositivo, para que todas as apps com sessão iniciada nele usem o mesmo idioma. «Automático» segue o idioma definido neste telemóvel."
          }
        }
      }
    },
    "app.settings.language_this_phone" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät braucht ein Software-Update, um diese Auswahl mit deinen anderen Apps zu teilen. Bis dahin gilt sie nur für dieses Handy."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your device needs a software update to share this choice with your other apps. Until then it applies to this phone only."
