    "app.settings.update.slow" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät ist noch nicht wieder da. Es kann etwas länger dauern; wenn es nicht zurückkommt, zieh den Stecker und steck ihn wieder ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device hasn't come back yet. It can take a little longer; if it doesn't come back, unplug it and plug it back in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo aún no ha vuelto. Puede tardar un poco más; si no vuelve, desenchúfalo y vuelve a enchufarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil n’est pas encore revenu. Cela peut prendre un peu plus de temps ; s’il ne revient pas, débranchez-le et rebranchez-le."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo non è ancora tornato attivo. Può volerci un po’ di più; se non torna, scollegalo dalla corrente e ricollegalo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat is nog niet terug. Het kan iets langer duren; komt het niet terug, haal dan de stekker eruit en steek hem er weer in."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo ainda não voltou. Pode demorar um pouco mais; se não voltar, desliga-o da corrente e volta a ligá-lo."
          }
        }
      }
    },
