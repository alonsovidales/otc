        }
      }
    },
    "app.settings.tailscale.limit_bandwidth" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Die Bandbreite ist begrenzt.</b> Tailscale begrenzt, was durch Funnel gehen kann, und veröffentlicht das Limit nicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Bandwidth is capped.</b> Tailscale limits what can pass through Funnel and doesn't publish the limit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>El ancho de banda está limitado.</b> Tailscale limita lo que puede pasar por Funnel y no publica ese límite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Bande passante plafonnée.</b> Tailscale limite ce qui peut transiter par Funnel et ne publie pas ce plafond."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>La banda è limitata.</b> Tailscale limita ciò che può passare tramite Funnel e non pubblica il limite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>De bandbreedte is beperkt.</b> Tailscale beperkt wat er via Funnel kan, en maakt die limiet niet bekend."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>A largura de banda é limitada.</b> O Tailscale limita o que pode passar pelo Funnel e não publica esse limite."
          }
        }
      }
    },
    "app.settings.tailscale.limit_one_user" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Nur ein Benutzer.</b> Weitere Benutzer brauchen jeweils eine eigene Webadresse, und Funnel gibt diesem Rechner nur eine."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>One user only.</b> Extra users need a web address each, and Funnel gives this machine a single one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Solo un usuario.</b> Los usuarios adicionales necesitan cada uno su propia dirección web, y Funnel solo da una a esta máquina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Un seul utilisateur.</b> Les utilisateurs supplémentaires ont chacun besoin d’une adresse web, et Funnel n’en attribue qu’une à cette machine."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Un solo utente.</b> Gli utenti aggiuntivi hanno bisogno di un indirizzo web ciascuno, e Funnel dà a questa macchina un solo indirizzo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Maar één gebruiker.</b> Extra gebruikers hebben elk een eigen webadres nodig, en Funnel geeft deze machine er maar één."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Apenas um utilizador.</b> Os utilizadores extra precisam de um endereço web cada um, e o Funnel dá um só a esta máquina."
          }
        }
      }
    },
    "app.settings.tailscale.limit_social" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Die sozialen Funktionen gehen nicht.</b> Freunde finden sich über die Bridge, daher sind Teilen und die Timelines von Freunden nicht verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>The social side won't work.</b> Friends find each other through the bridge, so sharing and friends' timelines are unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>La parte social no funcionará.</b> Los amigos se encuentran a través del puente, así que no se puede compartir ni ver las publicaciones de los amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>La partie sociale ne fonctionnera pas.</b> Les amis se retrouvent via la passerelle : le partage et les fils de vos amis sont donc indisponibles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>La parte social non funzionerà.</b> Gli amici si trovano tramite il bridge, quindi la condivisione e i feed degli amici non sono disponibili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Het sociale deel werkt niet.</b> Vrienden vinden elkaar via de bridge, dus delen en de tijdlijnen van vrienden zijn niet beschikbaar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>A parte social não funciona.</b> Os amigos encontram-se através da ponte, por isso a partilha e as cronologias dos amigos ficam indisponíveis."
          }
        }
      }
    },
    "app.settings.tailscale.no_funnel" : {
