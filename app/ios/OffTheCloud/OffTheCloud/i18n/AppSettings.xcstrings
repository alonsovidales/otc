        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu dispositivo necesita una actualización de software para compartir esta elección con tus otras apps. Hasta entonces, solo se aplica a este teléfono."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre appareil a besoin d’une mise à jour logicielle pour partager ce choix avec vos autres apps. D’ici là, il ne s’applique qu’à ce téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo dispositivo ha bisogno di un aggiornamento software per condividere questa scelta con le altre app. Fino ad allora vale solo per questo telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
