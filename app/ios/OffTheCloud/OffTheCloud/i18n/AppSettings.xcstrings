    "app.settings.tailscale.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel ist eine Alternative zur Bridge von Off The Cloud: Es veröffentlicht dieses Gerät unter deiner eigenen Adresse auf ts.net, allerdings mit folgenden Einschränkungen:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel is an alternative to the Off The Cloud bridge, it publishes this device on your own ts.net address but with the next limitations:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel es una alternativa al puente de Off The Cloud: publica este dispositivo en tu propia dirección ts.net, pero con las siguientes limitaciones:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel est une alternative à la passerelle Off The Cloud : il publie cet appareil à votre propre adresse ts.net, mais avec les limites suivantes :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel è un’alternativa al bridge di Off The Cloud: pubblica questo dispositivo su un tuo indirizzo ts.net, ma con i seguenti limiti:"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale Funnel is een alternatief voor de Off The Cloud-bridge: het publiceert dit apparaat op je eigen adres op ts.net, maar met deze beperkingen:"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Tailscale Funnel é uma alternativa à ponte Off The Cloud: publica este dispositivo no teu próprio endereço ts.net, mas com as seguintes limitações:"
          }
        }
      }
    },
    "app.settings.tailscale.key_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit einem Schlüssel aus deiner Tailscale-Admin-Konsole läuft das von selbst durch. Ohne Schlüssel wirst du zu Tailscale weitergeleitet, um dieses Gerät zu autorisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "With a key from your Tailscale admin console this finishes on its own. Without one, you'll be taken to Tailscale to authorise this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una clave de tu consola de administración de Tailscale, esto termina por sí solo. Sin ella, se abrirá Tailscale para que autorices este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec une clé générée dans la console d’administration Tailscale, l’opération se termine d’elle-même. Sans clé, Tailscale s’ouvrira pour que vous autorisiez cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con una chiave della console di amministrazione di Tailscale la procedura si completa da sola. Senza, si apre Tailscale per autorizzare questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met een sleutel uit je Tailscale-beheerconsole gaat dit vanzelf. Zonder sleutel word je naar Tailscale gestuurd om dit apparaat te autoriseren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com uma chave da consola de administração do Tailscale, isto conclui-se sozinho. Sem chave, abrimos o Tailscale para autorizares este dispositivo."
          }
        }
      }
    },
    "app.settings.tailscale.limit_account" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Du brauchst ein Tailscale-Konto,</b> bei dem Funnel für dein tailnet aktiviert ist."
          }
        },
        "en" : {
