    "app.settings.update.restart_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist dann etwa eine Minute lang nicht erreichbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It will be unreachable for about a minute."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estará accesible durante alrededor de un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il sera injoignable pendant environ une minute."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sarà raggiungibile per circa un minuto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is dan ongeveer een minuut onbereikbaar."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fica inacessível durante cerca de um minuto."
          }
        }
      }
    },
    "app.settings.update.restart_note" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät kompiliert seine Software neu und startet neu, was ein paar Minuten dauert und diese Verbindung zwischendurch trennt. Deine Fotos und Einstellungen bleiben unberührt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device rebuilds itself and restarts, which takes a few minutes and drops this connection on the way. Your photos and settings are left alone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo se recompila y se reinicia, lo que tarda unos minutos y corta esta conexión mientras tanto. Tus fotos y ajustes no se tocan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil se recompile et redémarre, ce qui prend quelques minutes et interrompt cette connexion au passage. Vos photos et paramètres ne sont pas touchés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo si ricompila e si riavvia: ci vogliono alcuni minuti e nel frattempo questa connessione si interrompe. Le tue foto e le tue impostazioni restano intatte."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat bouwt zichzelf opnieuw en herstart; dat duurt een paar minuten en verbreekt onderweg deze verbinding. Je foto’s en instellingen blijven onaangeroerd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo recompila-se e reinicia, o que demora alguns minutos e corta esta ligação pelo caminho. As tuas fotos e definições não são afetadas."
          }
        }
      }
    },
    "app.settings.update.restart_old" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Gerät braucht ein Update, bevor es von hier aus neu gestartet werden kann."
