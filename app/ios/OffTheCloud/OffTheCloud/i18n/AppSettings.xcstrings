    "app.settings.sync.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Alles synchronisieren“ geht die gesamte Mediathek noch einmal durch. „Ab jetzt synchronisieren“ überspringt alles, was schon darin ist: Nur Fotos und Videos, die ab jetzt aufgenommen werden, werden hochgeladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sync All goes through the whole library again. Sync From Now skips everything already in it: only photos and videos taken from now on are uploaded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sincronizar todo” vuelve a recorrer toda la biblioteca. “Sincronizar desde ahora” omite todo lo que ya contiene: solo se suben las fotos y los vídeos que se hagan a partir de ahora."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Tout synchroniser » parcourt de nouveau toute la bibliothèque. « Synchroniser dès maintenant » ignore tout ce qui s’y trouve déjà : seules les photos et vidéos prises à partir de maintenant sont envoyées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Sincronizza tutto” ripercorre l’intera libreria. “Sincronizza da ora” salta tutto ciò che contiene già: vengono caricati solo le foto e i video scattati da ora in poi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Alles synchroniseren” gaat opnieuw door de hele bibliotheek. “Vanaf nu synchroniseren” slaat alles over wat er al in staat: alleen foto’s en video’s die vanaf nu worden gemaakt, worden geüpload."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sincronizar tudo» percorre novamente toda a biblioteca. «Sincronizar a partir de agora» ignora tudo o que já lá está: só são carregadas as fotos e os vídeos tirados a partir de agora."
          }
        }
      }
    },
