    "app.settings.connection.log_out_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Verbindung, der Synchronisierungsverlauf und alles, was vom Gerät zwischengespeichert wurde, werden von diesem Handy entfernt. Auf dem Gerät selbst wird nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connection, the sync history and everything cached from the device are removed from this phone. Nothing on the device itself is deleted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán de este teléfono la conexión, el historial de sincronización y todo lo almacenado en caché desde el dispositivo. No se elimina nada del propio dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connexion, l’historique de synchronisation et tout ce qui a été mis en cache depuis l’appareil sont supprimés de ce téléphone. Rien n’est supprimé sur l’appareil lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La connessione, la cronologia di sincronizzazione e tutti i dati del dispositivo salvati nella cache vengono rimossi da questo telefono. Sul dispositivo stesso non viene eliminato nulla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De verbinding, de synchronisatiegeschiedenis en alles wat van het apparaat in de cache staat, worden van deze telefoon verwijderd. Op het apparaat zelf wordt niets verwijderd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ligação, o histórico de sincronização e tudo o que estiver em cache do dispositivo são removidos deste telemóvel. Nada é eliminado no próprio dispositivo."
          }
        }
      }
    },
