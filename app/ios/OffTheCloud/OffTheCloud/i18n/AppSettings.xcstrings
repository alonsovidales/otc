    "app.settings.logs.warning" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protokolle können Datei- und Ordnernamen, Suchbegriffe, WLAN-Namen und die Adressen deines Geräts enthalten. Prüfe sie, bevor du sie teilst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logs can include file and folder names, search words, Wi-Fi network names and your device's addresses. Check them before you share them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los registros pueden incluir nombres de archivos y carpetas, palabras de búsqueda, nombres de redes Wi-Fi y las direcciones de tu dispositivo. Revísalos antes de compartirlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux peuvent contenir des noms de fichiers et de dossiers, des mots recherchés, des noms de réseaux Wi-Fi et les adresses de votre appareil. Vérifiez-les avant de les partager."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I log possono includere nomi di file e di cartella, parole cercate, nomi di reti Wi-Fi e gli indirizzi del tuo dispositivo. Controllali prima di condividerli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Logboeken kunnen namen van bestanden en mappen, zoekwoorden, namen van wifinetwerken en de adressen van je apparaat bevatten. Controleer ze voordat je ze deelt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os registos podem incluir nomes de ficheiros e pastas, palavras pesquisadas, nomes de redes Wi-Fi e os endereços do teu dispositivo. Verifica-os antes de os partilhares."
          }
        }
      }
    },
