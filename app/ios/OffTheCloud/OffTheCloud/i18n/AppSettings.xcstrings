    "app.settings.tailscale.suits" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es eignet sich für ein Gerät, das du rein als dein eigenes privates NAS nutzen möchtest – deine Dateien und Fotos, von überall erreichbar, nichts mit anderen geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "It suits a device you want purely as your own private NAS — your files and photos, reachable from anywhere, nothing shared with anyone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es adecuado para un dispositivo que quieres usar solo como tu propio NAS privado: tus archivos y fotos, accesibles desde cualquier lugar, sin compartir nada con nadie."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Convient à un appareil que vous voulez utiliser uniquement comme NAS privé : vos fichiers et photos, joignables de partout, sans rien partager avec personne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È adatto a un dispositivo che vuoi usare solo come tuo NAS privato: i tuoi file e le tue foto, raggiungibili da qualsiasi luogo, senza condividere niente con nessuno."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het is geschikt voor een apparaat dat je puur als je eigen privé-NAS wilt gebruiken: je bestanden en foto’s, overal bereikbaar, niets gedeeld met anderen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "É adequado para um dispositivo que queres usar apenas como o teu NAS privado: os teus ficheiros e fotos, acessíveis a partir de qualquer lado, sem nada partilhado com ninguém."
          }
        }
      }
    },
