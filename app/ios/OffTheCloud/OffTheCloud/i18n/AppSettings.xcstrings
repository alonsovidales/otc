    "app.settings.bridge.leave_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wird freigegeben und das Gerät startet neu. Es behält alles und funktioniert zu Hause, ist aber von außerhalb und für deine Freunde nicht mehr erreichbar. Du kannst später wieder beitreten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is given back and the device restarts. It keeps everything and works at home, but is no longer reachable from outside or by your friends. You can join again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ quedará libre y el dispositivo se reiniciará. Lo conservará todo y seguirá funcionando en casa, pero ya no será accesible desde fuera ni para tus amigos. Puedes volver a unirte más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le nom %1$@ est libéré et l’appareil redémarre. Il conserve tout et continue de fonctionner à la maison, mais n’est plus joignable depuis l’extérieur ni par vos amis. Vous pourrez rejoindre de nouveau la passerelle plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il nome %1$@ viene rilasciato e il dispositivo si riavvia. Conserva tutto e funziona a casa, ma non è più raggiungibile dall’esterno né dai tuoi amici. Puoi unirti di nuovo al bridge più tardi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wordt vrijgegeven en het apparaat herstart. Alles blijft bewaard en het werkt thuis, maar is niet meer bereikbaar van buitenaf of voor je vrienden. Je kunt later opnieuw verbinding maken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O nome %1$@ é devolvido e o dispositivo reinicia. Mantém tudo e funciona em casa, mas deixa de estar acessível a partir do exterior e para os teus amigos. Podes voltar a ligá-lo mais tarde."
          }
        }
      }
    },
