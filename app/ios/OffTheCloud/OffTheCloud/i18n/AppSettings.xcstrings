    "app.settings.bridge.released" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät hat die Bridge verlassen: %1$@ kannte seinen Namen nicht mehr (das Konto wurde gelöscht oder der Name freigegeben). Alles darauf ist noch da."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device left the bridge: %1$@ no longer knew its name (its account was deleted, or the name released). Everything on it is still there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo ha salido del puente: %1$@ ya no reconocía su nombre (se eliminó su cuenta o se liberó el nombre). Todo lo que contiene sigue ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil a quitté la passerelle : la passerelle %1$@ ne connaissait plus son nom (son compte a été supprimé ou le nom a été libéré). Tout ce qu’il contient est toujours là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo dispositivo ha lasciato il bridge: %1$@ non conosceva più il suo nome (il suo account è stato eliminato, o il nome è stato rilasciato). Tutto ciò che contiene è ancora lì."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat heeft de bridge verlaten: %1$@ kende de naam niet meer (het account is verwijderd, of de naam is vrijgegeven). Alles wat erop staat, is er nog."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este dispositivo saiu da ponte: %1$@ deixou de conhecer o nome dele (a conta foi eliminada ou o nome foi libertado). Tudo o que tem continua lá."
          }
        }
      }
    },
