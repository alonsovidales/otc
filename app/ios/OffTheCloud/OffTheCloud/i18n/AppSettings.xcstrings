    "app.settings.logs.send_explain" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet den letzten Teil der Protokolle deines Geräts, deine Notiz und die E-Mail-Adresse deines Kontos an info@off-the.cloud, damit wir helfen können. Protokolle können Datei- und Ordnernamen, Suchbegriffe, WLAN-Namen und die Adressen deines Geräts enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sends the last part of your device's logs, your note and your account's email to info@off-the.cloud, so we can help. Logs can include file and folder names, search words, Wi-Fi network names and your device's addresses."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía la última parte de los registros de tu dispositivo, tu nota y el correo electrónico de tu cuenta a info@off-the.cloud para que podamos ayudarte. Los registros pueden incluir nombres de archivos y carpetas, palabras de búsqueda, nombres de redes Wi-Fi y las direcciones de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie la dernière partie des journaux de votre appareil, votre note et l’adresse e-mail de votre compte à info@off-the.cloud, pour que nous puissions vous aider. Les journaux peuvent contenir des noms de fichiers et de dossiers, des mots recherchés, des noms de réseaux Wi-Fi et les adresses de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia l’ultima parte dei log del tuo dispositivo, la tua nota e l’email del tuo account a info@off-the.cloud, così possiamo aiutarti. I log possono includere nomi di file e di cartella, parole cercate, nomi di reti Wi-Fi e gli indirizzi del tuo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuurt het laatste deel van de logboeken van je apparaat, je opmerking en het e-mailadres van je account naar info@off-the.cloud, zodat we je kunnen helpen. Logboeken kunnen namen van bestanden en mappen, zoekwoorden, namen van wifinetwerken en de adressen van je apparaat bevatten."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envia a última parte dos registos do teu dispositivo, a tua nota e o email da tua conta para info@off-the.cloud, para te podermos ajudar. Os registos podem incluir nomes de ficheiros e pastas, palavras pesquisadas, nomes de redes Wi-Fi e os endereços do teu dispositivo."
          }
        }
      }
    },
