    "app.settings.reprocess.confirm_restart" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Foto und Video in deiner Mediathek neu verarbeiten? Dabei werden alle vorhandenen Tags und erkannten Personen gelöscht und von Grund auf neu erstellt. Das kann eine Weile dauern und nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprocess every photo and video in your library? This deletes all existing tags and recognized people and rebuilds them from scratch. It can take a while and can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Reprocesar todas las fotos y vídeos de tu biblioteca? Se eliminarán todas las etiquetas y personas reconocidas existentes y se volverán a generar desde cero. Puede tardar un rato y no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retraiter toutes les photos et vidéos de votre bibliothèque ? Cette opération supprime toutes les étiquettes et personnes reconnues existantes, puis les reconstruit de zéro. Elle peut prendre un moment et est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rielaborare ogni foto e video della tua libreria? L’operazione elimina tutte le etichette e le persone riconosciute esistenti e le ricostruisce da zero. Può richiedere un po’ di tempo e non può essere annullata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke foto en video in je bibliotheek opnieuw verwerken? Hiermee worden alle bestaande tags en herkende personen verwijderd en vanaf nul opnieuw opgebouwd. Dit kan even duren en kan niet ongedaan worden gemaakt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprocessar todas as fotos e vídeos da tua biblioteca? Isto elimina todas as etiquetas e pessoas reconhecidas existentes e volta a criá-las do zero. Pode demorar algum tempo, e esta ação não pode ser anulada."
          }
        }
      }
    },
    "app.settings.reprocess.confirm_resume" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
