    "app.settings.reprocess.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt die Bilderkennung und die Gesichtserkennung für jedes Foto und Video in deiner Mediathek erneut aus – nützlich nach einer Korrektur der Erkennung oder einem Update des Modells. Dabei werden zuerst die vorhandenen Tags und erkannten Personen gelöscht und von Grund auf neu erstellt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Re-run tagging and face detection on every photo and video already in your library — useful after a detection fix or model update. This clears existing tags and recognized people first and rebuilds them from scratch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ejecutar el etiquetado y la detección de caras en todas las fotos y vídeos que ya hay en tu biblioteca: útil después de una corrección de la detección o de una actualización del modelo. Primero borra las etiquetas y personas reconocidas existentes y luego las vuelve a generar desde cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relancer l’étiquetage et la détection des visages sur toutes les photos et vidéos déjà présentes dans votre bibliothèque : utile après une correction de la détection ou une mise à jour du modèle. Les étiquettes et personnes reconnues existantes sont d’abord effacées, puis reconstruites de zéro."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esegue di nuovo l’etichettatura e il rilevamento dei volti su ogni foto e video già presente nella tua libreria: utile dopo una correzione del rilevamento o un aggiornamento del modello. Prima elimina le etichette e le persone riconosciute esistenti, poi le ricostruisce da zero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voert beeldherkenning en gezichtsdetectie opnieuw uit op elke foto en video die al in je bibliotheek staat: handig na een verbetering van de detectie of een update van het model. Hiermee worden eerst de bestaande tags en herkende personen gewist, waarna ze vanaf nul opnieuw worden opgebouwd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volta a executar a etiquetagem e a deteção de rostos em todas as fotos e vídeos que já estão na tua biblioteca: útil depois de uma correção na deteção ou de uma atualização do modelo. Primeiro, isto elimina as etiquetas e as pessoas reconhecidas existentes e depois volta a criá-las do zero."
          }
        }
      }
    },
