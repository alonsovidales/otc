    "app.settings.bridge.delete_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät verlässt zuerst die Bridge und funktioniert zu Hause weiter. Dann öffnet sich deine Kontoseite: Melde dich dort an und lösche das Konto, wodurch auch die Namen aller anderen Geräte freigegeben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This device leaves the bridge first and goes on working at home. Then your account page opens: sign in there and delete the account, which releases any other devices' names too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primero, este dispositivo sale del puente y sigue funcionando en casa. Después se abre la página de tu cuenta: inicia sesión allí y elimina la cuenta, lo que también libera los nombres de tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil quitte d’abord la passerelle et continue de fonctionner à la maison. Ensuite, la page de votre compte s’ouvre : connectez-vous et supprimez le compte, ce qui libère aussi les noms de vos autres appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prima questo dispositivo lascia il bridge e continua a funzionare a casa. Poi si apre la pagina del tuo account: accedi lì ed elimina l’account; in questo modo vengono rilasciati anche i nomi di eventuali altri dispositivi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit apparaat verlaat eerst de bridge en blijft thuis werken. Daarna wordt je accountpagina geopend: log daar in en verwijder het account. Daarmee worden ook de namen van eventuele andere apparaten vrijgegeven."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Primeiro, este dispositivo sai da ponte e continua a funcionar em casa. Depois, abre-se a página da tua conta: inicia sessão aí e elimina a conta, o que também liberta os nomes de quaisquer outros dispositivos."
          }
        }
      }
    },
