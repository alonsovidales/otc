    "app.settings.users.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder Benutzer läuft als eigene, vollständig getrennte Instanz – eigener Port, eigene Datenbank, eigener Speicher – und wird nur hier verwaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Each user runs as its own fully separate instance — own port, own database, own storage — managed only from here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada usuario se ejecuta como su propia instancia totalmente independiente (su propio puerto, su propia base de datos y su propio almacenamiento) y solo se gestiona desde aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque utilisateur fonctionne comme une instance entièrement séparée (son propre port, sa propre base de données, son propre stockage), gérée uniquement depuis cet écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni utente funziona come un’istanza propria, completamente separata (porta, database e spazio di archiviazione propri), gestita solo da qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elke gebruiker draait als een eigen, volledig gescheiden instantie (eigen poort, eigen database, eigen opslag) en wordt alleen hier beheerd."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada utilizador funciona como uma instância própria e totalmente separada (porta própria, base de dados própria, armazenamento próprio), gerida apenas a partir daqui."
          }
        }
      }
    },
