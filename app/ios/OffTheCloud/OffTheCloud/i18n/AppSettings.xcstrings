      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ is given back and the device restarts. It keeps everything and works at home, but is no longer reachable from outside or by your friends. You can join again later."
          }
        }
      }
    },
