    "app.settings.bridge.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Verlassen wird der Name freigegeben; das Gerät funktioniert zu Hause weiter, unter http://%1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leaving gives the name back; the device keeps working at home, at http://%1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al salir se libera el nombre; el dispositivo sigue funcionando en casa, en http://%1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter la passerelle libère le nom ; l’appareil continue de fonctionner à la maison, à l’adresse http://%1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lasci il bridge, il nome viene rilasciato; il dispositivo continua a funzionare a casa, all’indirizzo http://%1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als je de bridge verlaat, wordt de naam vrijgegeven; het apparaat blijft thuis werken, op http://%1$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair da ponte devolve o nome; o dispositivo continua a funcionar em casa, em http://%1$@."
          }
        }
      }
    },
