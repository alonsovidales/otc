    "app.settings.bridge.left" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät startet ohne Bridge neu. Ab jetzt erreicht die App es in deinem Heimnetz unter %1$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device is restarting off the bridge. From now on the app reaches it on your home network, at %1$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo se está reiniciando fuera del puente. A partir de ahora, la app se conecta a él a través de tu red doméstica, en %1$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil redémarre hors de la passerelle. Désormais, l’app le joint sur votre réseau domestique, à l’adresse %1$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo si sta riavviando fuori dal bridge. D’ora in poi l’app lo raggiunge sulla tua rete domestica, all’indirizzo %1$@."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat herstart zonder bridge. Vanaf nu bereikt de app het via je thuisnetwerk, op %1$@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo está a reiniciar fora da ponte. A partir de agora, a app liga-se a ele na tua rede doméstica, em %1$@."
          }
        }
      }
    },
    "app.settings.bridge.local_only" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur in deinem Heimnetz erreichbar. Tritt der Bridge in den Einstellungen der Web-App des Geräts bei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only reachable on your home network. Join the bridge from Settings in the device's web app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo es accesible desde tu red doméstica. Únete al puente desde Ajustes en la app web del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Joignable uniquement sur votre réseau domestique. Rejoignez la passerelle depuis les Paramètres de l’app web de l’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Raggiungibile solo sulla tua rete domestica. Unisciti al bridge da Impostazioni nell’app web del dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alleen bereikbaar op je thuisnetwerk. Maak verbinding met de bridge via Instellingen in de webapp van het apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só está acessível na tua rede doméstica. Liga-o à ponte em Definições, na app web do dispositivo."
          }
        }
      }
    },
    "app.settings.bridge.reachable" : {
      "extractionState" : "manual",
      "localizations" : {
