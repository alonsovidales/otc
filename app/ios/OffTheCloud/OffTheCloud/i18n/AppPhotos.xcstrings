    "app.photos.wallpaper.stored_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Damit es als Hintergrundbild erscheinen kann, wird eine Kopie des Fotos aus „%2$@“ in Bildschirmgröße auf diesem Telefon gespeichert. Sie bleibt dort, bis du die Sammlung nicht mehr als Hintergrundbild verwendest."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Damit sie als Hintergrundbild erscheinen können, werden Kopien von %arg Fotos aus „%2$@“ in Bildschirmgröße auf diesem Telefon gespeichert. Sie bleiben dort, bis du die Sammlung nicht mehr als Hintergrundbild verwendest."
                    }
                  }
                }
              }
            }
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "To show it as your wallpaper, a copy of the photo in “%2$@” is saved on this phone, sized for its screen. It stays there until you stop using the collection as wallpaper."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "To show them as your wallpaper, copies of %arg photos from “%2$@” are saved on this phone, sized for its screen. They stay there until you stop using the collection as wallpaper."
                    }
                  }
                }
              }
            }
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
