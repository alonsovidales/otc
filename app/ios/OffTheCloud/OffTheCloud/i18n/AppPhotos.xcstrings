    "app.photos.people.merge_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle das Gesicht, das bleiben soll: Es behält seinen Namen und sein Bild und erhält die Fotos der anderen. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick the face to keep: it keeps its name and picture, and gets the photos of the others. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la cara que quieres conservar: mantendrá su nombre y su imagen, y recibirá las fotos de las demás. Esto no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez le visage à garder : il conserve son nom et sa photo, et reçoit les photos des autres. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli il volto da mantenere: conserva il suo nome e la sua immagine, e riceve le foto degli altri. L’operazione non può essere annullata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies het gezicht dat je wilt behouden: het houdt zijn naam en foto, en krijgt de foto’s van de anderen. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolhe o rosto a manter: mantém o nome e a foto e fica com as fotos dos outros. Esta ação não pode ser anulada."
          }
        }
      }
    },
