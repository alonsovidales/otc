    "app.photos.people.delete_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos bleiben erhalten; nur die zugeordneten Gesichter werden vergessen. Das kann nicht rückgängig gemacht werden, und in später hinzugefügten Fotos werden sie als neue Personen erkannt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their photos stay; only the faces matched to them are forgotten. This can't be undone, and they'll come back as new people in photos added later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus fotos se conservan; solo se olvidan las caras que se les habían asociado. Esto no se puede deshacer, y en las fotos que se añadan más adelante aparecerán como personas nuevas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leurs photos restent ; seuls les visages qui leur ont été associés sont oubliés. Cette action est irréversible, et ces personnes réapparaîtront comme de nouvelles personnes dans les photos ajoutées plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le loro foto restano; vengono dimenticati solo i volti associati a loro. L’operazione non può essere annullata, e nelle foto aggiunte in seguito ricompariranno come nuove persone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hun foto’s blijven bewaard; alleen de gezichten die aan hen zijn gekoppeld, worden vergeten. Dit kan niet ongedaan worden gemaakt, en in foto’s die later worden toegevoegd, komen ze terug als nieuwe personen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos ficam; só são esquecidos os rostos associados. Esta ação não pode ser anulada, e quem for eliminado volta a aparecer como uma pessoa nova nas fotos adicionadas mais tarde."
          }
        }
      }
    },
