                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Para mostrarla como fondo de pantalla, se guarda en este teléfono una copia de la foto de “%2$@”, a la medida de su pantalla. Se queda ahí hasta que dejes de usar la colección como fondo de pantalla."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Para mostrarlas como fondo de pantalla, se guardan en este teléfono copias de %arg fotos de “%2$@”, a la medida de su pantalla. Se quedan ahí hasta que dejes de usar la colección como fondo de pantalla."
                    }
                  }
                }
              }
            }
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%#@count@"
          },
          "substitutions" : {
            "count" : {
              "argNum" : 1,
              "formatSpecifier" : "lld",
              "variations" : {
                "plural" : {
                  "one" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Pour l’afficher en fond d’écran, une copie de %arg photo de « %2$@ » est enregistrée sur ce téléphone, à la taille de son écran. Elle y reste jusqu’à ce que vous arrêtiez d’utiliser la collection comme fond d’écran."
                    }
                  },
                  "other" : {
                    "stringUnit" : {
                      "state" : "translated",
                      "value" : "Pour les afficher en fond d’écran, des copies de %arg photos de « %2$@ » sont enregistrées sur ce téléphone, à la taille de son écran. Elles y restent jusqu’à ce que vous arrêtiez d’utiliser la collection comme fond d’écran."
                    }
