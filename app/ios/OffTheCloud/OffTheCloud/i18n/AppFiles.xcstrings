    "app.files.make_upload_only_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Ordner kann nichts gelöscht werden – weder von diesem Handy noch von einem Computer oder im Web –, und beim erneuten Hochladen einer Datei bleibt ihre ältere Version erhalten. Gut für Fotoarchive und Backups."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing in this folder can be deleted - from this phone, a computer or the web - and uploading a file again keeps its older version. Good for photo archives and backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se podrá eliminar nada de esta carpeta (ni desde este teléfono, ni desde un ordenador ni desde la web), y al volver a subir un archivo se conservará su versión anterior. Ideal para archivar fotos y guardar copias de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien dans ce dossier ne peut être supprimé (depuis ce téléphone, un ordinateur ou le Web), et envoyer de nouveau un fichier conserve son ancienne version. Idéal pour les archives de photos et les sauvegardes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nulla in questa cartella potrà essere eliminato (da questo telefono, da un computer o dal web), e caricare di nuovo un file ne conserva la versione precedente. Ideale per archivi di foto e backup."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er kan niets uit deze map worden verwijderd (niet vanaf deze telefoon, een computer of het web), en als je een bestand opnieuw uploadt, wordt de oudere versie bewaard. Handig voor fotoarchieven en reservekopieën."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada nesta pasta pode ser eliminado (a partir deste telemóvel, de um computador ou da web), e carregar novamente um ficheiro mantém a versão anterior. Ideal para acervos de fotos e cópias de segurança."
          }
        }
      }
    },
