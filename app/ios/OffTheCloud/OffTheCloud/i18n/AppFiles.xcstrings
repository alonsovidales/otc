    "app.files.gallery_privacy" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos und Videos werden kopiert und mit einem eigenen Schlüssel neu verschlüsselt. Nur Personen mit dem Link können sie sehen, bis er abläuft."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "They are copied and re-encrypted with a key of their own. Only people with the link can see them, until it expires."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se copian y se cifran de nuevo con una clave propia. Solo las personas que tengan el enlace pueden verlos, hasta que caduque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elles sont copiées et chiffrées de nouveau avec une clé propre. Seules les personnes disposant du lien peuvent les voir, jusqu’à son expiration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vengono copiati e crittografati di nuovo con una chiave propria. Solo chi ha il link può vederli, finché non scade."
          }
        },
