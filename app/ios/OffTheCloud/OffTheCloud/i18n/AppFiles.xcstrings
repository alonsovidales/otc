          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwijderen in “%1$@” weer toestaan?"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voltar a permitir eliminações na pasta «%1$@»?"
          }
        }
      }
    },
