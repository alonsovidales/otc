    "app.files.keep_out_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Fotos und Videos darin erhalten keine Tags, werden nicht nach Gesichtern durchsucht und nicht in „Bilder“ angezeigt, und bereits darin gefundene Tags und Gesichter werden gelöscht. In Dateien sind sie weiterhin sichtbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its photos and videos won't be tagged, searched for faces or shown in Images, and the tags and faces already found in them are deleted. Files still shows them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus fotos y vídeos no se etiquetarán, no se analizarán en busca de caras ni se mostrarán en Imágenes, y se eliminarán las etiquetas y caras ya encontradas en ellos. Archivos los sigue mostrando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses photos et vidéos ne seront ni étiquetées, ni analysées pour y rechercher des visages, ni affichées dans Images, et les étiquettes et visages déjà trouvés dans ces fichiers seront supprimés. Elles restent visibles dans Fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le sue foto e i suoi video non verranno etichettati, analizzati alla ricerca di volti né mostrati in Immagini, e le etichette e i volti già trovati verranno eliminati. File continua a mostrarli."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De foto’s en video’s erin krijgen geen tags meer, worden niet doorzocht op gezichten en worden niet in Afbeeldingen getoond, en de tags en gezichten die er al in zijn gevonden, worden verwijderd. Bestanden toont ze nog wel."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos e os vídeos dela não vão ser etiquetados, analisados para encontrar rostos nem mostrados em Imagens, e as etiquetas e os rostos já encontrados neles são eliminados. Ficheiros continua a mostrá-los."
          }
        }
      }
    },
