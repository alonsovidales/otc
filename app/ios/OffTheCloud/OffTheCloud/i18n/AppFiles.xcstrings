{
  "sourceLanguage" : "en",
  "strings" : {
    "app.files.allow_deletions_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dateien in diesem Ordner können wieder gelöscht werden, und eine erneut hochgeladene Datei ersetzt die vorhandene. Die bisher aufbewahrten älteren Versionen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Files in this folder can be deleted again, and uploading a file again replaces it. The older versions kept so far stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos de esta carpeta se podrán volver a eliminar, y al volver a subir un archivo se sustituirá. Las versiones anteriores guardadas hasta ahora se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les fichiers de ce dossier peuvent de nouveau être supprimés, et envoyer de nouveau un fichier le remplace. Les anciennes versions conservées jusqu’ici restent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I file di questa cartella potranno di nuovo essere eliminati, e caricare di nuovo un file lo sostituirà. Le versioni precedenti conservate finora restano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestanden in deze map kunnen weer worden verwijderd, en als je een bestand opnieuw uploadt, wordt het vervangen. De oudere versies die tot nu toe zijn bewaard, blijven bestaan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ficheiros desta pasta voltam a poder ser eliminados, e carregar novamente um ficheiro substitui-o. As versões anteriores guardadas até agora mantêm-se."
          }
        }
      }
    },
    "app.files.allow_deletions_title" : {
