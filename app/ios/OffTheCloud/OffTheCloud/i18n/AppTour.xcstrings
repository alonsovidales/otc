    "app.tour.search.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Ding oder einen Ort ein, um Fotos zu finden, oder einen Teil eines Dateinamens, um die Datei in „Dateien“ zu finden. Jede Auswahl für Fotos erscheint mit einem ×; tippe darauf, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a thing or a place to find photos, or part of a file's name to find it in Files. Each pick for photos shows as a chip; tap its × to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una cosa o un lugar para encontrar fotos, o parte del nombre de un archivo para encontrarlo en Archivos. Lo que elijas para las fotos aparece con una ×; tócala para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une chose ou un lieu pour trouver des photos, ou une partie du nom d’un fichier pour le trouver dans Fichiers. Chaque choix pour les photos s’affiche avec une × ; touchez-la pour le retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita una cosa o un luogo per trovare foto, o parte del nome di un file per trovarlo in File. Ogni scelta per le foto compare con una ×: toccala per toglierla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ een ding of een plaats om foto’s te vinden, of een deel van een bestandsnaam om het bestand in Bestanden te vinden. Elke keuze voor foto’s verschijnt met een ×; tik erop om hem weg te halen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escreve uma coisa ou um lugar para encontrar fotos, ou parte do nome de um ficheiro para o encontrar em Ficheiros. Cada escolha para as fotos aparece com um ×: toca nele para a retirar."
          }
        }
      }
    },
    "app.tour.search.text_faces" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib ein Ding, einen Ort oder den Namen einer Person ein, um Fotos zu finden, oder einen Teil eines Dateinamens, um die Datei in „Dateien“ zu finden. Jede Auswahl für Fotos erscheint mit einem ×; tippe darauf, um sie zu entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Type a thing, a place or someone's name to find photos, or part of a file's name to find it in Files. Each pick for photos shows as a chip; tap its × to remove it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una cosa, un lugar o el nombre de alguien para encontrar fotos, o parte del nombre de un archivo para encontrarlo en Archivos. Lo que elijas para las fotos aparece con una ×; tócala para quitarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une chose, un lieu ou le nom de quelqu’un pour trouver des photos, ou une partie du nom d’un fichier pour le trouver dans Fichiers. Chaque choix pour les photos s’affiche avec une × ; touchez-la pour le retirer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digita una cosa, un luogo o il nome di qualcuno per trovare foto, o parte del nome di un file per trovarlo in File. Ogni scelta per le foto compare con una ×: toccala per toglierla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Typ een ding, een plaats of iemands naam om foto’s te vinden, of een deel van een bestandsnaam om het bestand in Bestanden te vinden. Elke keuze voor foto’s verschijnt met een ×; tik erop om hem weg te halen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
