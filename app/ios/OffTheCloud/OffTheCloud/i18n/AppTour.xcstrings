    "app.tour.done.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst diesen Rundgang jederzeit wieder ansehen: Tippe in <b>%2$@</b> auf <b>%1$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See this tour again any time: tap <b>%1$@</b> in <b>%2$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelve a ver este recorrido cuando quieras: toca <b>%1$@</b> en <b>%2$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoyez cette visite quand vous le souhaitez : touchez <b>%1$@</b> dans <b>%2$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi rivedere questo tour quando vuoi: tocca <b>%1$@</b> in <b>%2$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk deze rondleiding opnieuw wanneer je wilt: tik op <b>%1$@</b> in <b>%2$@</b>."
