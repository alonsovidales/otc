    "app.tour.collections.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewahre Fotos, die zusammengehören, an einem Ort auf, etwa von einer Reise oder einem Geburtstag. Halte in „Bilder“ Fotos gedrückt, um sie auszuwählen, und tippe dann auf <b>%1$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep photos that belong together in one place, like a trip or a birthday. Press and hold photos in Images to select them, then tap <b>%1$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reúne en un solo sitio las fotos que van juntas, como las de un viaje o un cumpleaños. Mantén pulsadas fotos en Imágenes para seleccionarlas y luego toca <b>%1$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rassemblez au même endroit les photos qui vont ensemble, comme celles d’un voyage ou d’un anniversaire. Dans Images, sélectionnez des photos par un appui long, puis touchez <b>%1$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riunisci in un unico posto le foto che vanno insieme, come quelle di un viaggio o di un compleanno. Tieni premute delle foto in Immagini per selezionarle, poi tocca <b>%1$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewaar foto’s die bij elkaar horen op één plek, zoals van een reis of een verjaardag. Houd foto’s in Afbeeldingen ingedrukt om ze te selecteren en tik dan op <b>%1$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Junta num só lugar as fotos que vão juntas, como as de uma viagem ou de um aniversário. Em Imagens, mantém premidas as fotos para as selecionares e toca em <b>%1$@</b>."
          }
        }
      }
    },
    "app.tour.collections.where" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Sammlungen öffnest du mit dieser Taste neben der Suche in „Bilder“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your collections open with this button, next to the search in Images."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus colecciones se abren con este botón, junto a la búsqueda de Imágenes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos collections s’ouvrent avec ce bouton, à côté de la recherche dans Images."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue raccolte si aprono con questo pulsante, accanto alla ricerca in Immagini."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je collecties open je met deze knop, naast de zoekbalk in Afbeeldingen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas coleções abrem-se com este botão, ao lado da pesquisa em Imagens."
          }
        }
      }
    },
