    "app.tour.friends.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schaltfläche mit zwei Personen oben öffnet „Freunde“: Teile dort deine Adresse oder gib unter <b>%1$@</b> den Namen des Geräts ein, das du hinzufügen möchtest, und tippe auf <b>%2$@</b>. Anfragen an dich warten unter <b>%3$@</b>: Tippe auf <b>%4$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The two-people button at the top opens Friends: share your address there, or type a friend's device name under <b>%1$@</b> and tap <b>%2$@</b>. A request to you waits under <b>%3$@</b>: tap <b>%4$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón de dos personas de arriba abre Amigos: comparte ahí tu dirección o escribe el nombre del dispositivo de un amigo en <b>%1$@</b> y toca <b>%2$@</b>. Las solicitudes que te envían esperan en <b>%3$@</b>: toca <b>%4$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton à deux personnes, en haut, ouvre Amis : partagez-y votre adresse, ou saisissez le nom de l’appareil d’un ami sous <b>%1$@</b> et touchez <b>%2$@</b>. Les demandes reçues attendent sous <b>%3$@</b> : touchez <b>%4$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante con due persone in alto apre Amici: condividi lì il tuo indirizzo, o digita il nome del dispositivo di un amico sotto <b>%1$@</b> e tocca <b>%2$@</b>. Le richieste che ricevi compaiono sotto <b>%3$@</b>: tocca <b>%4$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De knop met twee personen bovenaan opent Vrienden: deel daar je adres, of typ de apparaatnaam van een vriend onder <b>%1$@</b> en tik op <b>%2$@</b>. Verzoeken aan jou wachten onder <b>%3$@</b>: tik op <b>%4$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão com duas pessoas, em cima, abre Amigos: partilha aí o teu endereço, ou escreve o nome do dispositivo de um amigo em <b>%1$@</b> e toca em <b>%2$@</b>. Os pedidos que recebes esperam em <b>%3$@</b>: toca em <b>%4$@</b>."
          }
        }
      }
    },
    "app.tour.friends.text_wide" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teile deine Adresse, damit Freunde dich hinzufügen, oder gib unter <b>%1$@</b> den Namen ihres Geräts ein und tippe auf <b>%2$@</b>. Anfragen an dich warten unter <b>%3$@</b>: Tippe auf <b>%4$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share your address so friends can add you, or type their device's name under <b>%1$@</b> and tap <b>%2$@</b>. A request to you waits under <b>%3$@</b>: tap <b>%4$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comparte tu dirección para que tus amigos te añadan, o escribe el nombre de su dispositivo en <b>%1$@</b> y toca <b>%2$@</b>. Las solicitudes que te envían esperan en <b>%3$@</b>: toca <b>%4$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partagez votre adresse pour que vos amis vous ajoutent, ou saisissez le nom de leur appareil sous <b>%1$@</b> et touchez <b>%2$@</b>. Les demandes reçues attendent sous <b>%3$@</b> : touchez <b>%4$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Condividi il tuo indirizzo perché i tuoi amici ti aggiungano, o digita il nome del loro dispositivo sotto <b>%1$@</b> e tocca <b>%2$@</b>. Le richieste che ricevi compaiono sotto <b>%3$@</b>: tocca <b>%4$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deel je adres zodat vrienden je kunnen toevoegen, of typ de naam van hun apparaat onder <b>%1$@</b> en tik op <b>%2$@</b>. Verzoeken aan jou wachten onder <b>%3$@</b>: tik op <b>%4$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partilha o teu endereço para os teus amigos te adicionarem, ou escreve o nome do dispositivo deles em <b>%1$@</b> e toca em <b>%2$@</b>. Os pedidos que recebes esperam em <b>%3$@</b>: toca em <b>%4$@</b>."
          }
        }
      }
    },
