    "app.tour.images.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle deine Fotos und Videos, die neuesten zuerst. Suche oben nach Orten und Dingen auf deinen Fotos."
          }
        },
        "en" : {
