    "app.tour.backup.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Handy kopiert seine Fotos und Videos von selbst auf dein Gerät. Unter <b>%1$@</b> wählst du, was es sendet, und <b>%2$@</b> hält es von mobilen Daten fern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone copies its photos and videos to your device by itself. Under <b>%1$@</b> you choose what it sends, and <b>%2$@</b> keeps it off mobile data."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono copia sus fotos y vídeos en tu dispositivo por sí solo. En <b>%1$@</b> eliges qué envía, y <b>%2$@</b> evita que use los datos móviles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone copie tout seul ses photos et vidéos sur votre appareil. Sous <b>%1$@</b>, vous choisissez ce qu’il envoie, et <b>%2$@</b> l’empêche d’utiliser les données mobiles."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono copia da solo foto e video sul tuo dispositivo. In <b>%1$@</b> scegli cosa invia, e <b>%2$@</b> evita che usi i dati mobili."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze telefoon kopieert zijn foto’s en video’s vanzelf naar je apparaat. Onder <b>%1$@</b> kies je wat hij stuurt, en <b>%2$@</b> houdt hem van mobiele data af."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este telemóvel copia sozinho as suas fotos e vídeos para o teu dispositivo. Em <b>%1$@</b> escolhes o que envia, e <b>%2$@</b> evita que use dados móveis."
          }
        }
      }
    },
    "app.tour.backup.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
