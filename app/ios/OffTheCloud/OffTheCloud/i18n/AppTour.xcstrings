    "app.tour.upload.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> fügt dem offenen Ordner Dateien von diesem Handy hinzu; wähle welche über ihren Kreis aus und tippe auf <b>%2$@</b>, um einen Link zu senden, oder auf <b>%3$@</b>. Das Schloss neben einem Ordner stellt ihn auf „Nur hochladen“: Darin lässt sich nichts löschen, alte Versionen bleiben erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> adds files from this phone to the open folder; select some with their circles to <b>%2$@</b> a link or <b>%3$@</b> them. The lock beside a folder makes it upload only: nothing in it can be deleted and old versions are kept."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> añade archivos de este teléfono a la carpeta abierta; selecciona algunos con su círculo y elige <b>%2$@</b> para enviar un enlace, o <b>%3$@</b>. El candado junto a una carpeta la deja en solo subida: no se puede eliminar nada y se guardan las versiones anteriores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> ajoute des fichiers de ce téléphone au dossier ouvert ; sélectionnez-en avec leur cercle et choisissez <b>%2$@</b> pour transmettre un lien, ou <b>%3$@</b>. Le cadenas à côté d’un dossier le met en envoi uniquement : rien ne peut y être supprimé et les anciennes versions sont conservées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> aggiunge alla cartella aperta file da questo telefono; selezionane alcuni con il cerchio e scegli <b>%2$@</b> per inviare un link, o <b>%3$@</b>. Il lucchetto accanto a una cartella la rende di solo caricamento: niente si può eliminare e le versioni precedenti restano."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> voegt bestanden van deze telefoon toe aan de open map; selecteer er een paar met hun rondje en kies <b>%2$@</b> om een link te sturen, of <b>%3$@</b>. Het slotje naast een map zet hem op alleen uploaden: er kan niets uit worden verwijderd en oude versies blijven bewaard."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> adiciona ficheiros deste telemóvel à pasta aberta; seleciona alguns com o círculo e escolhe <b>%2$@</b> para enviar uma ligação, ou <b>%3$@</b>. O cadeado junto a uma pasta põe-na em apenas carregamento: nada nela pode ser eliminado e as versões antigas ficam guardadas."
          }
        }
      }
    },
