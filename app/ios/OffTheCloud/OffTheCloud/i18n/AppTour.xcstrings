          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos do teu telemóvel"
          }
        }
      }
    },
    "app.tour.collections.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle Fotos aus und tippe auf <b>%1$@</b> und dann auf <b>%2$@</b>, um sie zusammenzuhalten, etwa die einer Reise. Die Schaltfläche neben der Suche zeigt deine Sammlungen: Öffne eine, um sie umzubenennen, zu teilen oder zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select photos and choose <b>%1$@</b>, then <b>%2$@</b>, to keep them together, like a trip. The button next to the search lists your collections: open one to rename, share or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona fotos y elige <b>%1$@</b> y luego <b>%2$@</b> para tenerlas juntas, como las de un viaje. El botón junto a la búsqueda muestra tus colecciones: abre una para cambiarle el nombre, compartirla o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez des photos et choisissez <b>%1$@</b>, puis <b>%2$@</b>, pour les garder ensemble, comme celles d’un voyage. Le bouton à côté de la recherche affiche vos collections : ouvrez-en une pour la renommer, la partager ou la supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona le foto e scegli <b>%1$@</b>, poi <b>%2$@</b>, per tenerle insieme, come quelle di un viaggio. Il pulsante accanto alla ricerca mostra le tue raccolte: aprine una per rinominarla, condividerla o eliminarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer foto’s en kies <b>%1$@</b> en dan <b>%2$@</b> om ze bij elkaar te houden, zoals die van een reis. De knop naast de zoekbalk toont je collecties: open er een om de naam te wijzigen, hem te delen of te verwijderen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleciona fotos e escolhe <b>%1$@</b> e depois <b>%2$@</b> para as manter juntas, como as de uma viagem. O botão junto à pesquisa mostra as tuas coleções: abre uma para lhe mudar o nome, partilhá-la ou eliminá-la."
          }
        }
      }
    },
    "app.tour.collections.text_wide" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in „Bilder“ Fotos aus und tippe auf <b>%1$@</b> und dann auf <b>%2$@</b>, um sie zusammenzuhalten, etwa die einer Reise. Öffne hier eine Sammlung, um sie umzubenennen, als Galerie zu teilen oder zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select photos in Images and choose <b>%1$@</b>, then <b>%2$@</b>, to keep them together, like a trip. Open a collection here to rename it, share it as a gallery or delete it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona fotos en Imágenes y elige <b>%1$@</b> y luego <b>%2$@</b> para tenerlas juntas, como las de un viaje. Abre aquí una colección para cambiarle el nombre, compartirla como galería o eliminarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez des photos dans Images et choisissez <b>%1$@</b>, puis <b>%2$@</b>, pour les garder ensemble, comme celles d’un voyage. Ouvrez une collection ici pour la renommer, la partager en galerie ou la supprimer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona le foto in Immagini e scegli <b>%1$@</b>, poi <b>%2$@</b>, per tenerle insieme, come quelle di un viaggio. Apri qui una raccolta per rinominarla, condividerla come galleria o eliminarla."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecteer foto’s in Afbeeldingen en kies <b>%1$@</b> en dan <b>%2$@</b> om ze bij elkaar te houden, zoals die van een reis. Open hier een collectie om de naam te wijzigen, hem als galerij te delen of te verwijderen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleciona fotos em Imagens e escolhe <b>%1$@</b> e depois <b>%2$@</b> para as manter juntas, como as de uma viagem. Abre aqui uma coleção para lhe mudar o nome, partilhá-la como galeria ou eliminá-la."
          }
        }
      }
    },
    "app.tour.collections.title" : {
