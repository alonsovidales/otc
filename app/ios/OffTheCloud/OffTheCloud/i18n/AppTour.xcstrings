    "app.tour.select.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte ein Foto gedrückt und ziehe dann über weitere, um sie ebenfalls auszuwählen. Wähle dann in der Leiste unten <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> oder <b>%4$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Press and hold a photo, then drag across others to select them too. Then choose <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> or <b>%4$@</b> in the bar at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada una foto y arrastra sobre otras para seleccionarlas también. Luego elige <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> o <b>%4$@</b> en la barra de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez longuement sur une photo, puis faites glisser le doigt sur d’autres pour les sélectionner aussi. Choisissez ensuite <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> ou <b>%4$@</b> dans la barre du bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta una foto, poi trascina su altre per selezionare anche quelle. Poi scegli <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> o <b>%4$@</b> nella barra in basso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd een foto ingedrukt en sleep over andere om die ook te selecteren. Kies daarna <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> of <b>%4$@</b> in de balk onderaan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantém uma foto premida e arrasta sobre outras para as selecionar também. Depois escolhe <b>%1$@</b>, <b>%2$@</b>, <b>%3$@</b> ou <b>%4$@</b> na barra em baixo."
          }
        }
      }
    },
