          }
        }
      }
    },
    "app.tour.files.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schaltfläche neben dem Pfad des Ordners wechselt zwischen <b>%1$@</b>, <b>%2$@</b> und <b>%3$@</b>, der zeigt, was Platz belegt. Wähle unter <b>%4$@</b> eine Reihenfolge und wähle sie erneut, um sie umzukehren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The button beside the folder's path switches between <b>%1$@</b>, <b>%2$@</b> and <b>%3$@</b>, which shows what takes up space. Under <b>%4$@</b>, pick an order, and pick it again to reverse it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón junto a la ruta de la carpeta cambia entre <b>%1$@</b>, <b>%2$@</b> y <b>%3$@</b>, que muestra lo que ocupa espacio. En <b>%4$@</b>, elige un orden, y vuelve a elegirlo para invertirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton à côté du chemin du dossier permet de basculer entre <b>%1$@</b>, <b>%2$@</b> et <b>%3$@</b>, qui montre ce qui prend de la place. Sous <b>%4$@</b>, choisissez un ordre, et choisissez-le de nouveau pour l’inverser."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante accanto al percorso della cartella permette di passare tra <b>%1$@</b>, <b>%2$@</b> e <b>%3$@</b>, che mostra cosa occupa più posto. In <b>%4$@</b>, scegli un ordine, e sceglilo di nuovo per invertirlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De knop naast het pad van de map wisselt tussen <b>%1$@</b>, <b>%2$@</b> en <b>%3$@</b>, die laat zien wat ruimte inneemt. Kies onder <b>%4$@</b> een volgorde, en kies die nog eens om hem om te keren."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão junto ao caminho da pasta alterna entre <b>%1$@</b>, <b>%2$@</b> e <b>%3$@</b>, que mostra o que ocupa espaço. Em <b>%4$@</b>, escolhe uma ordem, e escolhe-a outra vez para a inverter."
          }
        }
      }
    },
