            "value" : "Alertas e Definições"
          }
        }
      }
    },
    "app.tour.backup.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Handy kann seine Fotos und Videos von selbst auf dein Gerät kopieren. Was es sendet, wählst du unter <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This phone can copy its photos and videos to your device by itself. Choose what it sends in <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este teléfono puede copiar sus fotos y vídeos en tu dispositivo por sí solo. Elige qué envía en <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone peut copier tout seul ses photos et vidéos sur votre appareil. Choisissez ce qu’il envoie dans <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo telefono può copiare da solo le sue foto e i suoi video sul tuo dispositivo. Scegli cosa invia in <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze telefoon kan zijn foto’s en video’s vanzelf naar je apparaat kopiëren. Kies wat hij stuurt in <b>%1$@</b> › <b>%2$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este telemóvel pode copiar sozinho as suas fotos e vídeos para o teu dispositivo. Escolhe o que envia em <b>%1$@</b> › <b>%2$@</b>."
          }
        }
      }
    },
    "app.tour.backup.title" : {
