    "app.tour.social.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein privater Feed mit Familie und Freunden: Gib Beiträgen mit dem Herzsymbol ein „Gefällt mir“ und kommentiere sie. Deine Beiträge gehen von deinem Gerät auf die Geräte deiner Freunde, und nur deine Freunde sehen sie."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your private feed with family and friends: like posts with the heart and comment on them. Your posts go from your device to your friends' devices, and only your friends see them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu feed privado con tu familia y tus amigos: dale Me gusta a las publicaciones con el corazón y coméntalas. Tus publicaciones van de tu dispositivo a los dispositivos de tus amigos, y solo ellos las ven."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre fil privé avec votre famille et vos amis : aimez les publications avec le cœur et commentez-les. Vos publications vont de votre appareil aux appareils de vos amis, et seuls vos amis les voient."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo feed privato con familiari e amici: metti Mi piace ai post con il cuore e commentali. I tuoi post vanno dal tuo dispositivo ai dispositivi dei tuoi amici, e solo i tuoi amici li vedono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je privéfeed met familie en vrienden: geef berichten een hartje en reageer erop. Je berichten gaan van jouw apparaat naar de apparaten van je vrienden, en alleen je vrienden zien ze."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O teu feed privado com a família e os amigos: põe Gosto nas publicações com o coração e comenta-as. As tuas publicações vão do teu dispositivo para os dispositivos dos teus amigos, e só eles as veem."
          }
        }
      }
    },
    "app.tour.welcome.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Fotos und Dateien liegen auf deinem eigenen Gerät, bei dir zu Hause. Teile sie mit Familie und Freunden in einem privaten Netzwerk, das nur dir gehört."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your photos and files live on your own device, at home. Share them with family and friends in a private network of your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus fotos y archivos están en tu propio dispositivo, en casa. Compártelos con tu familia y tus amigos en una red privada solo tuya."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos photos et vos fichiers sont sur votre propre appareil, chez vous. Partagez-les avec votre famille et vos amis dans un réseau privé rien qu’à vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue foto e i tuoi file si trovano sul tuo dispositivo, a casa tua. Condividili con familiari e amici in una rete privata tutta tua."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je foto’s en bestanden staan op je eigen apparaat, bij je thuis. Deel ze met familie en vrienden in een privénetwerk dat helemaal van jou is."
          }
        },
        "pt-PT" : {
