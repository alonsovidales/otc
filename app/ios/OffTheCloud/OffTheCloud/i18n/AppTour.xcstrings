    "app.tour.dates.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fotos sind nach Monaten gruppiert, die neuesten zuerst. Ziehe den Finger am rechten Rand der Fotos nach unten, um zu einem beliebigen Monat zu springen: Das Datum wird dabei angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos are grouped by month, newest first. Drag your finger down the right edge of the photos to jump to any month: the date shows as you go."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos se agrupan por meses, de la más reciente a la más antigua. Desliza el dedo hacia abajo por el borde derecho de las fotos para saltar a cualquier mes: la fecha aparece mientras lo haces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos sont regroupées par mois, des plus récentes aux plus anciennes. Faites glisser le doigt vers le bas le long du bord droit des photos pour aller à n’importe quel mois : la date s’affiche au fur et à mesure."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le foto sono raggruppate per mese, dalle più recenti. Trascina il dito verso il basso lungo il bordo destro delle foto per andare a qualsiasi mese: la data compare mentre scorri."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto’s zijn per maand gegroepeerd, de nieuwste eerst. Sleep je vinger langs de rechterrand van de foto’s omlaag om naar elke gewenste maand te springen: de datum verschijnt terwijl je sleept."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos estão agrupadas por mês, das mais recentes para as mais antigas. Arrasta o dedo para baixo pela margem direita das fotos para ir para qualquer mês: a data aparece enquanto o fazes."
          }
        }
      }
    },
    "app.tour.dates.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
