    "app.tour.people.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Schaltfläche neben der Suche öffnet „Personen“: Tippe auf ein Gesicht, um alle Fotos dieser Person zu sehen, oder auf <b>%1$@</b> unter einem Gesicht ohne Namen. Zwei Gesichter derselben Person? Halte eines gedrückt, tippe auf das andere und wähle <b>%2$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The button next to the search opens People: tap a face to see every photo of that person, or <b>%1$@</b> to name them. Two faces of one person? Press and hold one, tap the other and choose <b>%2$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón junto a la búsqueda abre Personas: toca una cara para ver todas las fotos de esa persona, o <b>%1$@</b> debajo de una cara sin nombre. ¿Dos caras de la misma persona? Mantén pulsada una, toca la otra y elige <b>%2$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bouton à côté de la recherche ouvre Personnes : touchez un visage pour voir toutes les photos de cette personne, ou <b>%1$@</b> sous un visage sans nom. Deux visages de la même personne ? Appuyez longuement sur l’un, touchez l’autre et choisissez <b>%2$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il pulsante accanto alla ricerca apre Persone: tocca un volto per vedere tutte le foto di quella persona, o <b>%1$@</b> sotto un volto senza nome. Due volti della stessa persona? Tieni premuto uno, tocca l’altro e scegli <b>%2$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De knop naast de zoekbalk opent Personen: tik op een gezicht om alle foto’s van die persoon te zien, of op <b>%1$@</b> onder een gezicht zonder naam. Twee gezichten van dezelfde persoon? Houd er een ingedrukt, tik op het andere en kies <b>%2$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O botão junto à pesquisa abre Pessoas: toca numa cara para ver todas as fotos dessa pessoa, ou em <b>%1$@</b> por baixo de uma cara sem nome. Duas caras da mesma pessoa? Mantém uma premida, toca na outra e escolhe <b>%2$@</b>."
          }
        }
      }
    },
