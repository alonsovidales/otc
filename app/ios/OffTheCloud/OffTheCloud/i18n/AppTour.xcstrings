    "app.tour.viewer.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf ein Foto, um es zu öffnen, und wische, um durch die Fotos zu blättern. Die Schaltfläche <b>%1$@</b> (ⓘ) zeigt, wann und wo es aufgenommen wurde, die Kamera und eine Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a photo to open it, then swipe to go through them. The <b>%1$@</b> button (ⓘ) shows when and where it was taken, the camera and a map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una foto para abrirla y desliza el dedo para pasar de una a otra. El botón <b>%1$@</b> (ⓘ) muestra cuándo y dónde se hizo, la cámara y un mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une photo pour l’ouvrir, puis balayez pour passer de l’une à l’autre. Le bouton <b>%1$@</b> (ⓘ) indique quand et où elle a été prise, l’appareil photo et une carte."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca una foto per aprirla, poi scorri con il dito per passare da una all’altra. Il pulsante <b>%1$@</b> (ⓘ) mostra quando e dove è stata scattata, la fotocamera e una mappa."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een foto om hem te openen en veeg om door de foto’s te bladeren. De knop <b>%1$@</b> (ⓘ) toont wanneer en waar hij is gemaakt, de camera en een kaart."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca numa foto para a abrir e desliza o dedo para passar de uma para outra. O botão <b>%1$@</b> (ⓘ) mostra quando e onde foi tirada, a câmara e um mapa."
          }
        }
      }
    },
