    "app.tour.social.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen deine Beiträge und die deiner Freunde, die neuesten zuerst. Tippe auf das Herz, um einen zu liken, schreibe darunter, um zu kommentieren, und tippe auf die Zahl der Likes, um zu sehen, wem er gefällt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your posts and your friends' show here, newest first. Tap the heart to like one, write under it to comment, and tap the number of likes to see who liked it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen tus publicaciones y las de tus amigos, de la más reciente a la más antigua. Toca el corazón para darle Me gusta a una, escribe debajo para comentar y toca el número de Me gusta para ver a quién le ha gustado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos publications et celles de vos amis s’affichent ici, des plus récentes aux plus anciennes. Touchez le cœur pour en aimer une, écrivez dessous pour commenter, et touchez le nombre de « J’aime » pour voir qui l’a aimée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono i tuoi post e quelli dei tuoi amici, dai più recenti. Tocca il cuore per mettere Mi piace, scrivi sotto per commentare e tocca il numero di Mi piace per vedere a chi piace."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier staan je berichten en die van je vrienden, de nieuwste eerst. Tik op het hartje om een bericht te liken, schrijf eronder om te reageren en tik op het aantal likes om te zien wie het leuk vindt."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui aparecem as tuas publicações e as dos teus amigos, das mais recentes para as mais antigas. Toca no coração para pôr Gosto, escreve por baixo para comentar e toca no número de gostos para ver quem gostou."
          }
        }
      }
    },
