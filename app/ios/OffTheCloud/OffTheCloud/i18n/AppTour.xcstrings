    "app.tour.welcome.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einer Minute siehst du, wie du findest, sortierst und teilst, was auf deinem Gerät ist. Alle Bereiche der App findest du in der Leiste unten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This takes a minute and shows how to find, sort and share what's on your device. Every part of the app is in the bar at the bottom."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En un minuto verás cómo encontrar, ordenar y compartir lo que hay en tu dispositivo. Todas las partes de la aplicación están en la barra de abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Découvrez en une minute comment trouver, trier et partager ce qui se trouve sur votre appareil. Toutes les parties de l’application sont dans la barre du bas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In un minuto vedrai come trovare, ordinare e condividere ciò che c’è sul tuo dispositivo. Tutte le parti dell’app sono nella barra in basso."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In een minuut zie je hoe je vindt, sorteert en deelt wat er op je apparaat staat. Alle onderdelen van de app staan in de balk onderaan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Num minuto vais ver como encontrar, ordenar e partilhar o que está no teu dispositivo. Todas as partes da aplicação estão na barra em baixo."
          }
        }
      }
    },
