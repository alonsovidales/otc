    "app.tour.post.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf <b>+</b>, wähle unter <b>%1$@</b> (dieses Handy) oder <b>%2$@</b> (schon auf deinem Gerät) Fotos oder Videos aus, schreibe eine Bildunterschrift und tippe auf <b>%3$@</b>. Der Beitrag geht von deinem Gerät auf die Geräte deiner Freunde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap <b>+</b>, pick photos or videos from <b>%1$@</b> (this phone) or <b>%2$@</b> (already on your device), write a caption and tap <b>%3$@</b>. It goes from your device to your friends' devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca <b>+</b>, elige fotos o vídeos de <b>%1$@</b> (este teléfono) o <b>%2$@</b> (ya en tu dispositivo), escribe un pie de foto y toca <b>%3$@</b>. La publicación va de tu dispositivo a los dispositivos de tus amigos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez <b>+</b>, choisissez des photos ou des vidéos dans <b>%1$@</b> (ce téléphone) ou <b>%2$@</b> (déjà sur votre appareil), écrivez une légende et touchez <b>%3$@</b>. La publication va de votre appareil aux appareils de vos amis."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca <b>+</b>, scegli foto o video da <b>%1$@</b> (questo telefono) o <b>%2$@</b> (già sul tuo dispositivo), scrivi una didascalia e tocca <b>%3$@</b>. Il post va dal tuo dispositivo ai dispositivi dei tuoi amici."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op <b>+</b>, kies foto’s of video’s uit <b>%1$@</b> (deze telefoon) of <b>%2$@</b> (al op je apparaat), schrijf een bijschrift en tik op <b>%3$@</b>. Het bericht gaat van jouw apparaat naar de apparaten van je vrienden."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca em <b>+</b>, escolhe fotos ou vídeos de <b>%1$@</b> (este telemóvel) ou <b>%2$@</b> (já no teu dispositivo), escreve uma legenda e toca em <b>%3$@</b>. A publicação vai do teu dispositivo para os dispositivos dos teus amigos."
          }
        }
      }
    },
