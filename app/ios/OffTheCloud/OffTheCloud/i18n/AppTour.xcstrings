    "app.tour.files.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Dokumente und Ordner, auf deinem Gerät gespeichert. Tippe unten auf <b>%1$@</b>, um Dateien von diesem Handy hinzuzufügen, und tippe auf eine Datei, um sie zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your documents and folders, kept on your device. Tap <b>%1$@</b> at the bottom to add files from this phone, and tap a file to open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus documentos y carpetas, guardados en tu dispositivo. Toca <b>%1$@</b> abajo para añadir archivos desde este teléfono y toca un archivo para abrirlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos documents et dossiers, conservés sur votre appareil. Touchez <b>%1$@</b> en bas pour ajouter des fichiers depuis ce téléphone, et touchez un fichier pour l’ouvrir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi documenti e le tue cartelle, conservati sul tuo dispositivo. Tocca <b>%1$@</b> in basso per aggiungere file da questo telefono e tocca un file per aprirlo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je documenten en mappen, bewaard op je apparaat. Tik onderaan op <b>%1$@</b> om bestanden van deze telefoon toe te voegen en tik op een bestand om het te openen."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os teus documentos e pastas, guardados no teu dispositivo. Toca em <b>%1$@</b> em baixo para adicionares ficheiros deste telemóvel e toca num ficheiro para o abrires."
          }
        }
      }
    },
    "app.tour.friends.accept" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Anfrage an dich wartet unter <b>%1$@</b>: Tippe auf <b>%2$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A request sent to you waits under <b>%1$@</b>: tap <b>%2$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes que te envían esperan en <b>%1$@</b>: toca <b>%2$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande qui vous est adressée attend sous <b>%1$@</b> : touchez <b>%2$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste che ricevi ti aspettano sotto <b>%1$@</b>: tocca <b>%2$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een verzoek aan jou wacht onder <b>%1$@</b>: tik op <b>%2$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pedidos que te enviam esperam em <b>%1$@</b>: toca em <b>%2$@</b>."
          }
        }
      }
    },
    "app.tour.friends.add" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Freunde hinzuzufügen, gib unter <b>%2$@</b> den Namen ihres Geräts ein – den Teil vor .%1$@ – und tippe auf <b>%3$@</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To add a friend, type their device's name, the part before .%1$@, under <b>%2$@</b> and tap <b>%3$@</b>."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para añadir amigos, escribe el nombre de su dispositivo, la parte antes de .%1$@, en el apartado <b>%2$@</b> y toca <b>%3$@</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour ajouter des amis, saisissez le nom de leur appareil, la partie avant .%1$@, sous <b>%2$@</b> et touchez <b>%3$@</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per aggiungere amici, digita il nome del loro dispositivo, la parte prima di .%1$@, sotto <b>%2$@</b> e tocca <b>%3$@</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om vrienden toe te voegen, typ je de naam van hun apparaat, het deel vóór .%1$@, onder <b>%2$@</b> en tik je op <b>%3$@</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para adicionar amigos, escreve o nome do dispositivo deles, a parte antes de .%1$@, em <b>%2$@</b> e toca em <b>%3$@</b>."
          }
        }
      }
    },
