{
  "sourceLanguage" : "en",
  "strings" : {
    "app.tour.alerts.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> zählt, was neu ist: Likes, Kommentare, Freundschaftsanfragen und Neues von deinem Gerät. <b>%2$@</b> enthält dein Profil, dein Passwort und die Sprache sowie <b>%3$@</b>, um dies erneut zu sehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> counts what's new: likes, comments, friend requests and news from your device. <b>%2$@</b> has your profile, password and language, and <b>%3$@</b> to see this again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> cuenta lo nuevo: Me gusta, comentarios, solicitudes de amistad y avisos de tu dispositivo. <b>%2$@</b> tiene tu perfil, tu contraseña y el idioma, y <b>%3$@</b> para volver a ver esto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> compte les nouveautés : « J’aime », commentaires, demandes d’ami et nouvelles de votre appareil. <b>%2$@</b> contient votre profil, votre mot de passe et la langue, et <b>%3$@</b> pour revoir ceci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> conta le novità: Mi piace, commenti, richieste di amicizia e notizie dal tuo dispositivo. <b>%2$@</b> ha il tuo profilo, la password e la lingua, e <b>%3$@</b> per rivedere tutto questo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> telt wat er nieuw is: likes, reacties, vriendschapsverzoeken en nieuws van je apparaat. <b>%2$@</b> bevat je profiel, wachtwoord en taal, en <b>%3$@</b> om dit opnieuw te zien."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> conta o que há de novo: gostos, comentários, pedidos de amizade e notícias do teu dispositivo. <b>%2$@</b> tem o teu perfil, a palavra-passe e o idioma, e <b>%3$@</b> para voltares a ver isto."
          }
        }
      }
    },
