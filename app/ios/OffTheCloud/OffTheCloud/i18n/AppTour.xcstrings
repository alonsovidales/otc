{
  "sourceLanguage" : "en",
  "strings" : {
    "app.tour.alerts.text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> informiert dich über Likes, Kommentare, Freundschaftsanfragen und dein Gerät. In <b>%2$@</b> änderst du dein Profil, dein Passwort und das Backup deiner Fotos."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> tells you about likes, comments, friend requests and your device. In <b>%2$@</b> you change your profile, password and photo backup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> te avisa de los Me gusta, los comentarios, las solicitudes de amistad y lo que pasa en tu dispositivo. En <b>%2$@</b> cambias tu perfil, tu contraseña y la copia de seguridad de las fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> vous informe des J’aime, des commentaires, des demandes d’ami et de ce qui se passe sur votre appareil. Dans <b>%2$@</b>, vous modifiez votre profil, votre mot de passe et la sauvegarde des photos."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> ti informa su Mi piace, commenti, richieste di amicizia e sul tuo dispositivo. In <b>%2$@</b> cambi il profilo, la password e il backup delle foto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> houdt je op de hoogte van likes, reacties, vriendschapsverzoeken en je apparaat. In <b>%2$@</b> wijzig je je profiel, je wachtwoord en de reservekopie van je foto’s."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>%1$@</b> informa-te sobre gostos, comentários, pedidos de amizade e o teu dispositivo. Em <b>%2$@</b> alteras o teu perfil, a palavra-passe e a cópia de segurança das fotos."
          }
        }
      }
    },
    "app.tour.alerts.title" : {
