    "app.tour.users.bridge" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lass <b>%1$@</b> eingeschaltet, dann bekommt die Person eine eigene Adresse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keep <b>%1$@</b> on to give them their own address."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja activado <b>%1$@</b> para darle su propia dirección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez <b>%1$@</b> activé pour lui donner sa propre adresse."
          }
        },
        "it" : {
          "stringUnit" : {
