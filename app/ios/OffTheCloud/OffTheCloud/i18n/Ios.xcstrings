    "ios.bluetooth_needed_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Bluetooth für Off The Cloud in den Einstellungen, um ein Gerät auf diese Weise einzurichten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Bluetooth for Off The Cloud in Settings to set a device up this way."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes, permite que Off The Cloud use el Bluetooth para configurar un dispositivo de esta forma."
