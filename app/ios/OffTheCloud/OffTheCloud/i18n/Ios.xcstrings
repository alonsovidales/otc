    "ios.settings.free_up_live_photos_detail" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät behält von einem Live Photo nur das Standbild, die Bewegung geht beim Löschen hier also verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device keeps only the still picture of a Live Photo, so its motion is lost once it's deleted here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo solo guarda la imagen fija de una Live Photo, así que su movimiento se pierde al eliminarla aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’appareil ne garde que l’image fixe d’une Live Photo : son mouvement est perdu une fois qu’elle est supprimée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo tiene solo l’immagine fissa di una Live Photo, quindi il movimento si perde quando la elimini qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat bewaart van een Live Photo alleen de foto zelf, dus de beweging gaat verloren als je hem hier verwijdert."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
