    "app.social.friends.ask_theirs" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät von %1$@ bitten, alles zu löschen, was ich geteilt habe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ask %1$@'s device to delete what I shared"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir al dispositivo de %1$@ que elimine lo que he compartido"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demander à l’appareil de %1$@ de supprimer ce que j’ai partagé"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi al dispositivo di %1$@ di eliminare ciò che ho condiviso"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het apparaat van %1$@ vragen om te verwijderen wat ik heb gedeeld"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pedir ao dispositivo de %1$@ que elimine o que partilhei"
          }
        }
      }
    },
    "app.social.friends.ask_theirs_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Beiträge, Kommentare und Likes auf dem Gerät der Person. Ist es offline, passiert das, sobald es sich das nächste Mal verbindet; bis dahin erscheint die Person als „Wird entfernt“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your posts, comments and likes on their device. If it's offline, it happens the next time it connects; until then they show as leaving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus publicaciones, comentarios y Me gusta en su dispositivo. Si no tiene conexión, se hará la próxima vez que se conecte; hasta entonces, la amistad aparece como “Saliendo”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos publications, commentaires et J’aime sur son appareil. S’il est hors ligne, la suppression aura lieu à sa prochaine connexion ; d’ici là, la personne apparaît avec l’état « Retrait en cours »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi post, commenti e Mi piace sul suo dispositivo. Se è offline, succede la prossima volta che si connette; fino ad allora l’amicizia risulta “In rimozione”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je berichten, reacties en likes op hun apparaat. Als dat offline is, gebeurt het de volgende keer dat het verbinding maakt; tot die tijd staat de vriendschap op “Wordt verwijderd”."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tuas publicações, comentários e gostos no dispositivo dessa pessoa. Se o dispositivo estiver sem ligação, isto acontece da próxima vez que se ligar; até lá, aparece como «A sair»."
          }
        }
      }
    },
    "app.social.friends.block" : {
      "extractionState" : "manual",
      "localizations" : {
