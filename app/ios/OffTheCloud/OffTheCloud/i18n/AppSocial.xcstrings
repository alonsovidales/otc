    "app.social.friends.remove_now_text" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wird nicht länger auf das Gerät der Person gewartet. Was es noch nicht gelöscht hat, bleibt dort."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stops waiting for their device. Whatever it hasn't deleted yet stays there."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se dejará de esperar a su dispositivo. Lo que aún no haya eliminado se quedará allí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela met fin à l’attente de son appareil. Ce qu’il n’a pas encore supprimé y reste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non si aspetterà più il suo dispositivo. Ciò che non ha ancora eliminato resta lì."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wordt niet langer gewacht op hun apparaat. Wat het nog niet heeft verwijderd, blijft daar staan."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixas de esperar pelo dispositivo dessa pessoa. O que ainda não tiver sido eliminado fica lá."
          }
        }
      }
    },
