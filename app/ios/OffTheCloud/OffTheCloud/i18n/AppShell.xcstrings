    "app.shell.setup_not_found" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch kein Gerät gefunden. Prüfe, ob es eingeschaltet ist und seine Laufwerke angeschlossen sind, und halte das Handy in seiner Nähe."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No device found yet. Check that it's on, with its disks connected, and keep the phone next to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha encontrado ningún dispositivo. Comprueba que está encendido, con sus discos conectados, y mantén el teléfono a su lado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun appareil trouvé pour l’instant. Vérifiez qu’il est allumé, avec ses disques branchés, et gardez le téléphone près de lui."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora nessun dispositivo trovato. Controlla che sia acceso, con i dischi collegati, e tieni il telefono vicino al dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nog geen apparaat gevonden. Controleer of het aanstaat met de schijven aangesloten, en houd de telefoon er vlakbij."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não foi encontrado nenhum dispositivo. Verifica se está ligado, com os discos instalados, e mantém o telemóvel perto dele."
          }
        }
      }
    },
