    "app.shell.no_answer_address" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät antwortet nicht. Vielleicht ist es ausgeschaltet oder die Adresse ist falsch."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The device isn't answering. It may be off, or the address may be wrong."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo no responde. Puede que esté apagado o que la dirección sea incorrecta."
          }
