    "app.shell.onboarding_last_device" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Gerät übernommen, das du verlassen hast. Tippe auf „Speichern und fortfahren“, um dich wieder damit zu verbinden, oder ändere die Angaben für ein anderes Gerät."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filled in from the device you left. Tap Save & Continue to connect to it again, or change it to use another one."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han rellenado con los datos del dispositivo que dejaste. Toca “Guardar y continuar” para volver a conectarte a él, o cámbialos para usar otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champs renseignés à partir de l’appareil que vous avez quitté. Touchez « Enregistrer et continuer » pour vous y reconnecter, ou modifiez-les pour en utiliser un autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campi compilati con i dati del dispositivo che hai lasciato. Tocca “Salva e continua” per riconnetterti, oppure modificali per usarne un altro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingevuld vanuit het apparaat dat je hebt verlaten. Tik op “Opslaan en doorgaan” om er opnieuw verbinding mee te maken, of wijzig de gegevens om een ander apparaat te gebruiken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenchido a partir do dispositivo de onde saíste. Toca em «Guardar e continuar» para voltares a ligar-te a ele ou altera-o para usares outro."
          }
        }
      }
    },
    "app.shell.onboarding_pending" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom Gerät übernommen, das du mit diesem Handy eingerichtet hast. Sobald seine Installation abgeschlossen ist (etwa 20 Minuten), tippe auf „Speichern und fortfahren“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Filled in from the device you set up with this phone. Once its install has finished (about 20 minutes), tap Save & Continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han rellenado con los datos del dispositivo que configuraste con este teléfono. Cuando termine su instalación (unos 20 minutos), toca “Guardar y continuar”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Champs renseignés à partir de l’appareil que vous avez configuré avec ce téléphone. Une fois son installation terminée (environ 20 minutes), touchez « Enregistrer et continuer »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Campi compilati con i dati del dispositivo che hai configurato con questo telefono. Al termine dell’installazione (circa 20 minuti), tocca “Salva e continua”."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingevuld vanuit het apparaat dat je met deze telefoon hebt ingesteld. Tik op “Opslaan en doorgaan” zodra de installatie klaar is (na ongeveer 20 minuten)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenchido a partir do dispositivo que configuraste com este telemóvel. Quando a instalação terminar (cerca de 20 minutos), toca em «Guardar e continuar»."
          }
        }
      }
    },
    "app.shell.onboarding_setup_footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für ein Gerät frisch aus der Verpackung: Die Einrichtung läuft über Bluetooth, und diese App wird zu seiner App. Melde dich zuerst ab, wenn du von einem anderen Gerät wechselst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For a device fresh out of the box: it runs the setup over Bluetooth, and this app becomes its app. Log out first if you are switching from another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para un dispositivo recién sacado de la caja: hace la configuración por Bluetooth y esta app pasa a ser su app. Si vienes de otro dispositivo, cierra sesión primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour un appareil tout juste sorti de sa boîte : la configuration se fait par Bluetooth, et cette app devient son app. Déconnectez-vous d’abord si vous changez d’appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per un dispositivo appena uscito dalla scatola: esegue la configurazione tramite Bluetooth e questa app diventa la sua app. Se stai passando da un altro dispositivo, esci prima da quello."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voor een apparaat dat net uit de doos komt: de configuratie loopt via Bluetooth, en deze app wordt de app van het apparaat. Log eerst uit als je overstapt van een ander apparaat."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para um dispositivo acabado de sair da caixa: faz a configuração por Bluetooth e esta app passa a ser a app dele. Se estiveres a mudar de outro dispositivo, termina primeiro a sessão."
          }
        }
      }
    },
