    "app.shell.setup_several" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehrere Geräte warten auf die Einrichtung. Die ID jedes Geräts steht auf seiner Einrichtungsseite, wo „Licht blinken lassen“ zeigt, welches Gerät es ist. Das stärkste Signal ist meist das nächstgelegene."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Several devices are waiting to be set up. Each one's ID is on its setup page, where \"Blink its light\" shows which box it is. The strongest signal is usually the closest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay varios dispositivos esperando a que los configures. El ID de cada uno está en su página de configuración, donde “Hacer parpadear la luz” muestra cuál es. La señal más fuerte suele ser la del más cercano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plusieurs appareils attendent d’être configurés. L’identifiant de chacun figure sur sa page de configuration, où « Faire clignoter le voyant » indique de quel appareil il s’agit. Le signal le plus fort est généralement celui du plus proche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci sono diversi dispositivi in attesa di configurazione. L’ID di ciascuno è sulla sua pagina di configurazione, dove “Fai lampeggiare la luce” mostra di quale dispositivo si tratta. Il segnale più forte di solito è quello del più vicino."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er wachten meerdere apparaten om te worden ingesteld. De ID van elk apparaat staat op de configuratiepagina ervan, waar je met “Lampje laten knipperen” ziet welk apparaat het is. Het sterkste signaal is meestal het dichtstbijzijnde."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Há vários dispositivos à espera de configuração. O ID de cada um está na respetiva página de configuração, onde «Fazer piscar a luz» mostra qual é qual. O sinal mais forte costuma ser o mais próximo."
          }
        }
      }
    },
