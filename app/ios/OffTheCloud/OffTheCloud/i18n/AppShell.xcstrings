        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Gerät wird weiter installiert. Öffne die Einrichtung erneut, um sie zu verfolgen, oder melde dich an, sobald sie fertig ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
