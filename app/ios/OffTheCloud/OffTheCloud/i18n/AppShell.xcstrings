    "app.shell.unreachable_wifi_hint" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast den Namen oder das Passwort deines WLANs geändert? Verbinde das Gerät mit einem Ethernet-Kabel mit deinem Router und öffne dann Einstellungen › WLAN."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changed your Wi-Fi's name or password? Connect the device to your router with an Ethernet cable, then open Settings › Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Has cambiado el nombre o la contraseña de tu Wi-Fi? Conecta el dispositivo al router con un cable Ethernet y abre Ajustes › Wi-Fi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez changé le nom ou le mot de passe de votre Wi-Fi ? Reliez l’appareil à votre routeur avec un câble Ethernet, puis ouvrez Paramètres › Wi-Fi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai cambiato il nome o la password del tuo Wi-Fi? Collega il dispositivo al router con un cavo Ethernet, poi apri Impostazioni › Wi-Fi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heb je de naam of het wachtwoord van je wifi gewijzigd? Sluit het apparaat met een ethernetkabel aan op je router en open daarna Instellingen › Wifi."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mudaste o nome ou a palavra-passe do teu Wi-Fi? Liga o dispositivo ao teu router com um cabo Ethernet e depois abre Definições › Wi-Fi."
          }
        }
      }
    },
