    "app.shell.leave_message_connection" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kehrst zum Verbindungsbildschirm zurück, um dich mit einem Gerät zu verbinden oder ein neues einzurichten. Auf dem Gerät wird nichts gelöscht, und seine Adresse und sein Passwort bleiben dort eingetragen, damit du dich später wieder damit verbinden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll go back to the connection screen, to connect to a device or set up a new one. Nothing on the device is deleted, and its address and password stay filled in there, to connect to it again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volverás a la pantalla de conexión para conectarte a un dispositivo o configurar uno nuevo. No se elimina nada del dispositivo, y su dirección y su contraseña seguirán rellenadas allí para volver a conectarte más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous reviendrez à l’écran de connexion, pour vous connecter à un appareil ou en configurer un nouveau. Rien n’est supprimé sur l’appareil, et son adresse et son mot de passe resteront renseignés sur cet écran, pour vous y reconnecter plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornerai alla schermata di connessione, per connetterti a un dispositivo o configurarne uno nuovo. Sul dispositivo non viene eliminato nulla, e il suo indirizzo e la sua password restano inseriti lì, per riconnetterti in seguito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaat terug naar het verbindingsscherm om verbinding te maken met een apparaat of een nieuw apparaat in te stellen. Er wordt niets op het apparaat verwijderd, en het adres en wachtwoord blijven daar ingevuld, zodat je later opnieuw verbinding kunt maken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vais voltar ao ecrã de ligação, para te ligares a um dispositivo ou configurares um novo. Nada é eliminado no dispositivo, e o endereço e a palavra-passe dele continuam preenchidos lá, para voltares a ligar-te mais tarde."
          }
        }
      }
    },
    "app.shell.leave_message_start" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kehrst zum Anfang zurück, um ein neues Gerät einzurichten oder dich mit einem anderen zu verbinden. Auf dem Gerät wird nichts gelöscht, und seine Adresse und sein Passwort bleiben dort eingetragen, damit du dich später wieder damit verbinden kannst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You'll go back to the start, to set up a new device or connect to another one. Nothing on the device is deleted, and its address and password stay filled in there, to connect to it again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Volverás al inicio para configurar un dispositivo nuevo o conectarte a otro. No se elimina nada del dispositivo, y su dirección y su contraseña seguirán rellenadas allí para volver a conectarte más adelante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous reviendrez à l’écran d’accueil, pour configurer un nouvel appareil ou vous connecter à un autre. Rien n’est supprimé sur l’appareil, et son adresse et son mot de passe resteront renseignés sur cet écran, pour vous y reconnecter plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornerai all’inizio, per configurare un nuovo dispositivo o connetterti a un altro. Sul dispositivo non viene eliminato nulla, e il suo indirizzo e la sua password restano inseriti lì, per riconnetterti in seguito."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gaat terug naar het begin om een nieuw apparaat in te stellen of verbinding te maken met een ander apparaat. Er wordt niets op het apparaat verwijderd, en het adres en wachtwoord blijven daar ingevuld, zodat je later opnieuw verbinding kunt maken."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vais voltar ao início, para configurares um novo dispositivo ou te ligares a outro. Nada é eliminado no dispositivo, e o endereço e a palavra-passe dele continuam preenchidos lá, para voltares a ligar-te mais tarde."
          }
        }
      }
    },
