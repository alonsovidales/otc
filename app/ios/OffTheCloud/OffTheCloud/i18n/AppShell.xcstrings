        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo sigue instalándose. Vuelve a abrir la configuración para seguirla, o inicia sesión cuando termine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
