<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>cloud.off-the.OffTheCloud.sync</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- A device on the home LAN is reached over plain ws://http:// by IP or
		     .local name; everything off the LAN (the bridge, Tailscale) is TLS.
		     Scoped to local networking rather than disabling ATS outright. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>processing</string>
		<string>fetch</string>
		<string>remote-notification</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Off The Cloud connects to your own device on your home network to sync photos and files.</string>
</dict>
</plist>
