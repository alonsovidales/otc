<?xml version="1.0" encoding="utf-8"?>
<!-- A PlayerView drawn on a TextureView: a SurfaceView inside a Compose
     LazyColumn keeps a stale on-screen position and paints over whatever
     scrolls above it (it hid the feed's logo masthead, issue #126).
     surface_type can only be set from XML, hence this layout. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="zoom" />
