<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: On this day's strip and slideshow on sample data, to
     look at them without a device (adb shell am start -n
     cloud.offthe.otc/.MemoriesPreviewActivity [- -ez open true]). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name=".MemoriesPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- Smart search's Settings section and search on sample data
             (adb shell am start -n cloud.offthe.otc/.SmartSearchPreviewActivity [- -es show settings]
             [- -es model missing|downloading|problem|ready]). -->
        <activity
            android:name=".SmartSearchPreviewActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- Settings > Background work on sample tasks
             (adb shell am start -n cloud.offthe.otc/.BackgroundWorkPreviewActivity). -->
        <activity
            android:name=".BackgroundWorkPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- People's and Collections' Sort by and Images' "Back to the map" on
             sample data (adb shell am start -n cloud.offthe.otc/.PageSortPreviewActivity). -->
        <activity
            android:name=".PageSortPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- Favourites: the viewer's heart and Collections' empty Favourites on
             sample data (adb shell am start -n cloud.offthe.otc/.FavouritesPreviewActivity
             [- -es device demo|old|silent] [- -es show collections]). -->
        <activity
            android:name=".FavouritesPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- A person's face: the face's menu at the top of their photos and Use
             this face in the selection bar and the viewer, on sample data
             (adb shell am start -n cloud.offthe.otc/.PersonCoverPreviewActivity
             [- -es device demo|old]). -->
        <activity
            android:name=".PersonCoverPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- A photo's faces: the viewer's Info with its People (faces, people
             added by hand, Add a person) on sample data
             (adb shell am start -n cloud.offthe.otc/.PhotoFacesPreviewActivity
             [- -es device demo|noadd|old|off]). -->
        <activity
            android:name=".PhotoFacesPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- A collection's Rating: the header's star, Sort by and Show, the
             tiles' marks and the viewer's stars and comment box on sample
             data (adb shell am start -n cloud.offthe.otc/.RatingPreviewActivity
             [- -ez off true] [- -es device demo|old]). -->
        <activity
            android:name=".RatingPreviewActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- The setup page's profile picture through SetupPicture, as the
             Bluetooth setup hands it over (adb shell am start -n
             cloud.offthe.otc/.SetupPicturePreviewActivity [- -es path <file>] [- -ez raw true]). -->
        <activity
            android:name=".SetupPicturePreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- The photo editor (rotate and crop), a video's cut and Revert to
             Original over the viewer, on sample data and the assets' sample
             video (adb shell am start -n
             cloud.offthe.otc/.PhotoEditPreviewActivity [- -ez editor true]
             [- -ei photo 1] [- -es device demo|old] [- -es video <uri>]; the
             first video is - -ei photo 3). -->
        <activity
            android:name=".PhotoEditPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- Settings > Largest files, its list, the viewer over it and the
             Compress dialog with a pretend job, on sample data (adb shell am
             start -n cloud.offthe.otc/.CompressPreviewActivity [- -es show
             largest|compress|bar] [- -es device demo|old|slow]). -->
        <activity
            android:name=".CompressPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
        <!-- Text in photos and Pets: Settings' People section with Pets under
             Face Recognition, then Smart search's and Text in photos'
             sections, on sample data (adb shell am start -n
             cloud.offthe.otc/.TextInPhotosPreviewActivity [- -es show info]:
             Info's Text in this photo with Copy). -->
        <activity
            android:name=".TextInPhotosPreviewActivity"
            android:exported="true"
            android:theme="@style/Theme.OffTheCloud" />
    </application>
</manifest>
