# Copy to .env next to compose.yaml and adjust.

# One folder for everything the device keeps: storage/ (photos, files and the
# database), state/ and config/. Put it on redundant, local storage - a RAID,
# ZFS or Btrfs mirror, a NAS pool - not on NFS, SMB or a FUSE share such as
# Unraid's /mnt/user. Back it up, except storage/mysql/: the nightly copies in
# storage/db-dumps/ are what a restore loads.
OTC_DATA=/srv/otc

# The ports the device uses on this server (host networking). Each must be
# free; the container refuses to start otherwise and says which one.
OTC_HTTP_PORT=8080
OTC_LAN_TLS_PORT=8443
OTC_DB_PORT=3316
