# Copy to .env next to compose.yaml and adjust.

# One folder for everything the device keeps: storage/ (photos, files and the
# database), state/ and config/. Put it on redundant, local storage - a RAID,
# ZFS or Btrfs mirror, a NAS pool - not on NFS, SMB or a FUSE share such as
# Unraid's /mnt/user. Back it up, except storage/mysql/: the nightly copies in
# storage/db-dumps/ are what a restore loads. With the two-disk mirror below,
# storage/ stays empty: the mirror holds photos, files and the database.
OTC_DATA=/srv/otc

# The ports the device uses on this server (host networking). Each must be
# free; the container refuses to start otherwise and says which one.
OTC_HTTP_PORT=8080
OTC_LAN_TLS_PORT=8443
OTC_DB_PORT=3316

# Optional, before the first start: two disks of this server, mirrored by the
# device itself, as on a Raspberry Pi (docs/docker.md, "Two disks, mirrored").
# Name each whole disk as ls -l /dev/disk/by-id/ lists it, never a -partN.
# Not for a NAS that mirrors its own disks (Synology, TrueNAS, Unraid).
# COMPOSE_FILE=compose.yaml:compose.mirror.yaml
# OTC_MIRROR_DISK1=/dev/disk/by-id/ata-WDC_WD40EFRX-68N32N0_WD-WCC7K1111111
# OTC_MIRROR_DISK2=/dev/disk/by-id/ata-WDC_WD40EFRX-68N32N0_WD-WCC7K2222222
# Only when a named disk holds something (old partitions, a filesystem): the
# disks that may be erased, written exactly as above, separated by spaces.
# Never needed for blank disks.
# OTC_MIRROR_ERASE=/dev/disk/by-id/ata-WDC_WD40EFRX-68N32N0_WD-WCC7K2222222
