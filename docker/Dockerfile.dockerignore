!face_recognition/
!files_manager/
!geotag/
!hardening/
!i18n/
!images_embedder/
!images_quality/
!images_tagger/
!lantls/
!log/
!mediastream/
!modelserver/
!network/
!profile/
!proto/messages.proto
!push/
!raidwatch/
!segcrypt/
!session/
!settings/
!social/
!staticassets/
!status/
!storage/
!storagewatch/
!supervisor/
!tailscalefunnel/
!updater/
!websocket/
!wifiwatch/
!wsframe/
!models/models/tag_list_4585.txt.gz
!scripts/install.sh
!scripts/bridge-runner/otc-bridge-runner.sh
!scripts/release-signing.pub
!docker/
