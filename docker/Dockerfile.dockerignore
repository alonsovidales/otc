# docker/Dockerfile's build context, as an allowlist: the device's Go
# packages, the schema, the tag list, the scripts the image ships and this
# directory. Anything else a checkout holds - notes, keys, the apps, build
# output - never reaches a build, even one made from a working copy.
*
!go.mod
!go.sum
!alerttext/
!api/
!bin/
!blobstore/
!bridgeaccess/
